using Microsoft.Xrm.Sdk;
using Microsoft.Xrm.Sdk.Query;
using System;
using System.IO;
using System.Linq;
using System.Net;
using System.Runtime.Serialization;
using System.Runtime.Serialization.Json;
using System.Text;
using System.Threading;

namespace CTP.VendorQuoteAgent
{
    /// <summary>
    /// Dataverse Custom API plug-in for ctp_InvokeVendorQuoteAgent.
    /// Option B: Plug-in calls Copilot Studio agent through Direct Line.
    ///
    /// Required Custom API contract:
    ///   Input:  ctp_RequestJson  (String)
    ///   Output: ctp_ResponseJson (String)
    ///
    /// Required Environment Variables:
    ///   ctp_CopilotDirectLineTokenEndpoint  = Copilot Studio Mobile app Token Endpoint
    ///   ctp_CopilotDirectLineBaseUrl        = https://directline.botframework.com
    ///   ctp_CopilotAgentName                = exact agent name, optional but useful
    ///   ctp_CopilotBridgeTimeoutSeconds     = 25
    /// </summary>
    public class InvokeVendorQuoteAgentPlugin : IPlugin
    {
        private const string RequestParameterName = "ctp_RequestJson";
        private const string ResponsePropertyName = "ctp_ResponseJson";
        private const string PortalUserId = "ctp-embedded-portal";
        private const string PortalUserName = "CTP Embedded Portal";

        public void Execute(IServiceProvider serviceProvider)
        {
            var context = (IPluginExecutionContext)serviceProvider.GetService(typeof(IPluginExecutionContext));
            var tracing = (ITracingService)serviceProvider.GetService(typeof(ITracingService));
            var serviceFactory = (IOrganizationServiceFactory)serviceProvider.GetService(typeof(IOrganizationServiceFactory));
            var service = serviceFactory.CreateOrganizationService(context.UserId);

            try
            {
                tracing.Trace("ctp_InvokeVendorQuoteAgent started.");

                string requestJson = GetInputString(context, RequestParameterName);
                if (string.IsNullOrWhiteSpace(requestJson))
                {
                    context.OutputParameters[ResponsePropertyName] = ErrorJson("Missing Request", "ctp_RequestJson is required.");
                    return;
                }

                string tokenEndpoint = GetEnvironmentVariable(service, "ctp_CopilotDirectLineTokenEndpoint");
                string directLineBaseUrl = GetEnvironmentVariable(service, "ctp_CopilotDirectLineBaseUrl");
                string agentName = GetEnvironmentVariable(service, "ctp_CopilotAgentName");
                string timeoutSecondsRaw = GetEnvironmentVariable(service, "ctp_CopilotBridgeTimeoutSeconds");

                if (string.IsNullOrWhiteSpace(directLineBaseUrl))
                    directLineBaseUrl = "https://directline.botframework.com";

                int timeoutSeconds = 25;
                int parsedTimeout;
                if (int.TryParse(timeoutSecondsRaw, out parsedTimeout) && parsedTimeout > 0)
                    timeoutSeconds = Math.Min(parsedTimeout, 45);

                if (string.IsNullOrWhiteSpace(tokenEndpoint))
                {
                    context.OutputParameters[ResponsePropertyName] = ErrorJson(
                        "Missing Configuration",
                        "Environment variable ctp_CopilotDirectLineTokenEndpoint is missing. Copy the Token Endpoint from Copilot Studio > Channels > Mobile app.");
                    return;
                }

                DirectLineToken token = HttpGetJson<DirectLineToken>(tokenEndpoint, null, tracing, timeoutSeconds);
                if (token == null || string.IsNullOrWhiteSpace(token.Token))
                {
                    context.OutputParameters[ResponsePropertyName] = ErrorJson("Token Error", "Could not retrieve Direct Line token from Copilot Studio token endpoint.");
                    return;
                }

                Conversation conversation = StartConversation(directLineBaseUrl, token.Token, tracing, timeoutSeconds);
                string conversationId = conversation != null && !string.IsNullOrWhiteSpace(conversation.ConversationId)
                    ? conversation.ConversationId
                    : token.ConversationId;

                if (string.IsNullOrWhiteSpace(conversationId))
                {
                    context.OutputParameters[ResponsePropertyName] = ErrorJson("Conversation Error", "Could not start Direct Line conversation.");
                    return;
                }

                string bridgePrompt = BuildAgentPrompt(requestJson);
                PostMessageToAgent(directLineBaseUrl, token.Token, conversationId, bridgePrompt, tracing, timeoutSeconds);

                string agentResponseJson = WaitForAgentJsonResponse(
                    directLineBaseUrl,
                    token.Token,
                    conversationId,
                    agentName,
                    timeoutSeconds,
                    tracing);

                if (string.IsNullOrWhiteSpace(agentResponseJson))
                {
                    context.OutputParameters[ResponsePropertyName] = ErrorJson(
                        "Agent Timeout",
                        "The Copilot Agent did not return valid JSON within the configured timeout. Keep agent responses short, return JSON only, and use file references instead of large file payloads.");
                    return;
                }

                context.OutputParameters[ResponsePropertyName] = agentResponseJson;
                tracing.Trace("ctp_InvokeVendorQuoteAgent completed successfully.");
            }
            catch (Exception ex)
            {
                tracing.Trace("ctp_InvokeVendorQuoteAgent error: " + ex.ToString());
                context.OutputParameters[ResponsePropertyName] = ErrorJson("Bridge Error", ex.Message);
            }
        }

        private static string BuildAgentPrompt(string requestJson)
        {
            return
                "CTP_VENDOR_QUOTE_AGENT_REQUEST\n" +
                "You are being called from the Dynamics 365 Embedded Portal through Dataverse Custom API ctp_InvokeVendorQuoteAgent.\n" +
                "Return ONLY valid JSON. Do not include markdown, explanation, code fences, or extra text.\n" +
                "If operation is extract_map_preview, extract/map the quote and return a payload with header and lines.\n" +
                "If operation is approve_create_products, use the approved currentPayload and create the final records through your configured tools.\n" +
                "The request JSON is below.\n" +
                requestJson;
        }

        private static string GetInputString(IPluginExecutionContext context, string name)
        {
            if (context.InputParameters.Contains(name) && context.InputParameters[name] != null)
                return context.InputParameters[name].ToString();
            return string.Empty;
        }

        private static string GetEnvironmentVariable(IOrganizationService service, string schemaName)
        {
            var defQuery = new QueryExpression("environmentvariabledefinition")
            {
                ColumnSet = new ColumnSet("environmentvariabledefinitionid", "schemaname", "defaultvalue")
            };
            defQuery.Criteria.AddCondition("schemaname", ConditionOperator.Equal, schemaName);
            defQuery.TopCount = 1;

            var def = service.RetrieveMultiple(defQuery).Entities.FirstOrDefault();
            if (def == null)
                return string.Empty;

            var valQuery = new QueryExpression("environmentvariablevalue")
            {
                ColumnSet = new ColumnSet("value")
            };
            valQuery.Criteria.AddCondition("environmentvariabledefinitionid", ConditionOperator.Equal, def.Id);
            valQuery.TopCount = 1;

            var val = service.RetrieveMultiple(valQuery).Entities.FirstOrDefault();
            if (val != null && val.Contains("value"))
                return val.GetAttributeValue<string>("value") ?? string.Empty;

            return def.GetAttributeValue<string>("defaultvalue") ?? string.Empty;
        }

        private static Conversation StartConversation(string baseUrl, string token, ITracingService tracing, int timeoutSeconds)
        {
            string url = CombineUrl(baseUrl, "/v3/directline/conversations");
            return HttpPostJson<Conversation>(url, token, null, tracing, timeoutSeconds);
        }

        private static void PostMessageToAgent(string baseUrl, string token, string conversationId, string text, ITracingService tracing, int timeoutSeconds)
        {
            string url = CombineUrl(baseUrl, "/v3/directline/conversations/" + Uri.EscapeDataString(conversationId) + "/activities");

            var activity = new Activity
            {
                Type = "message",
                From = new ChannelAccount { Id = PortalUserId, Name = PortalUserName },
                Text = text,
                TextFormat = "plain",
                Locale = "en-US"
            };

            HttpPostJson<PostActivityResponse>(url, token, activity, tracing, timeoutSeconds);
        }

        private static string WaitForAgentJsonResponse(string baseUrl, string token, string conversationId, string agentName, int timeoutSeconds, ITracingService tracing)
        {
            string watermark = null;
            DateTime stopAt = DateTime.UtcNow.AddSeconds(timeoutSeconds);

            while (DateTime.UtcNow < stopAt)
            {
                Thread.Sleep(1000);

                string url = CombineUrl(baseUrl, "/v3/directline/conversations/" + Uri.EscapeDataString(conversationId) + "/activities");
                if (!string.IsNullOrWhiteSpace(watermark))
                    url += "?watermark=" + Uri.EscapeDataString(watermark);

                ActivitySet activitySet = HttpGetJson<ActivitySet>(url, token, tracing, 10);
                if (activitySet == null)
                    continue;

                if (!string.IsNullOrWhiteSpace(activitySet.Watermark))
                    watermark = activitySet.Watermark;

                if (activitySet.Activities == null || activitySet.Activities.Length == 0)
                    continue;

                foreach (var activity in activitySet.Activities)
                {
                    if (activity == null || !string.Equals(activity.Type, "message", StringComparison.OrdinalIgnoreCase))
                        continue;

                    if (activity.From != null && string.Equals(activity.From.Id, PortalUserId, StringComparison.OrdinalIgnoreCase))
                        continue;

                    if (!string.IsNullOrWhiteSpace(agentName) && activity.From != null && !string.IsNullOrWhiteSpace(activity.From.Name))
                    {
                        // Keep this soft. Some Copilot Studio channels do not return exactly the same display name.
                        tracing.Trace("Agent activity from: " + activity.From.Name);
                    }

                    string json = ExtractJsonObject(activity.Text);
                    if (!string.IsNullOrWhiteSpace(json))
                        return json;
                }
            }

            return string.Empty;
        }

        private static T HttpGetJson<T>(string url, string bearerToken, ITracingService tracing, int timeoutSeconds) where T : class
        {
            var request = (HttpWebRequest)WebRequest.Create(url);
            request.Method = "GET";
            request.Accept = "application/json";
            request.KeepAlive = false;
            request.Timeout = timeoutSeconds * 1000;
            request.ReadWriteTimeout = timeoutSeconds * 1000;

            if (!string.IsNullOrWhiteSpace(bearerToken))
                request.Headers[HttpRequestHeader.Authorization] = "Bearer " + bearerToken;

            using (var response = (HttpWebResponse)request.GetResponse())
            using (var stream = response.GetResponseStream())
            {
                return DeserializeJson<T>(stream);
            }
        }

        private static T HttpPostJson<T>(string url, string bearerToken, object body, ITracingService tracing, int timeoutSeconds) where T : class
        {
            var request = (HttpWebRequest)WebRequest.Create(url);
            request.Method = "POST";
            request.Accept = "application/json";
            request.ContentType = "application/json";
            request.KeepAlive = false;
            request.Timeout = timeoutSeconds * 1000;
            request.ReadWriteTimeout = timeoutSeconds * 1000;

            if (!string.IsNullOrWhiteSpace(bearerToken))
                request.Headers[HttpRequestHeader.Authorization] = "Bearer " + bearerToken;

            if (body == null)
            {
                request.ContentLength = 0;
            }
            else
            {
                byte[] bytes = Encoding.UTF8.GetBytes(SerializeJson(body));
                request.ContentLength = bytes.Length;
                using (var requestStream = request.GetRequestStream())
                {
                    requestStream.Write(bytes, 0, bytes.Length);
                }
            }

            using (var response = (HttpWebResponse)request.GetResponse())
            using (var stream = response.GetResponseStream())
            {
                if (stream == null)
                    return null;
                return DeserializeJson<T>(stream);
            }
        }

        private static string CombineUrl(string baseUrl, string path)
        {
            return (baseUrl ?? string.Empty).TrimEnd('/') + "/" + (path ?? string.Empty).TrimStart('/');
        }

        private static string SerializeJson(object obj)
        {
            using (var ms = new MemoryStream())
            {
                var serializer = new DataContractJsonSerializer(obj.GetType());
                serializer.WriteObject(ms, obj);
                return Encoding.UTF8.GetString(ms.ToArray());
            }
        }

        private static T DeserializeJson<T>(Stream stream) where T : class
        {
            if (stream == null)
                return null;
            var serializer = new DataContractJsonSerializer(typeof(T));
            return serializer.ReadObject(stream) as T;
        }

        private static string ExtractJsonObject(string text)
        {
            if (string.IsNullOrWhiteSpace(text))
                return string.Empty;

            string cleaned = text.Trim();
            if (cleaned.StartsWith("```", StringComparison.Ordinal))
            {
                int firstNewLine = cleaned.IndexOf('\n');
                int lastFence = cleaned.LastIndexOf("```", StringComparison.Ordinal);
                if (firstNewLine >= 0 && lastFence > firstNewLine)
                    cleaned = cleaned.Substring(firstNewLine + 1, lastFence - firstNewLine - 1).Trim();
            }

            int start = cleaned.IndexOf('{');
            if (start < 0)
                return string.Empty;

            int depth = 0;
            bool inString = false;
            bool escaped = false;

            for (int i = start; i < cleaned.Length; i++)
            {
                char c = cleaned[i];

                if (escaped)
                {
                    escaped = false;
                    continue;
                }

                if (c == '\\')
                {
                    escaped = true;
                    continue;
                }

                if (c == '"')
                {
                    inString = !inString;
                    continue;
                }

                if (inString)
                    continue;

                if (c == '{') depth++;
                if (c == '}') depth--;

                if (depth == 0)
                    return cleaned.Substring(start, i - start + 1).Trim();
            }

            return string.Empty;
        }

        private static string ErrorJson(string status, string message)
        {
            string safeStatus = EscapeJson(status ?? "Error");
            string safeMessage = EscapeJson(message ?? "Unknown error");
            return "{\"success\":false,\"status\":\"" + safeStatus + "\",\"message\":\"" + safeMessage + "\"}";
        }

        private static string EscapeJson(string value)
        {
            if (value == null) return string.Empty;
            return value.Replace("\\", "\\\\").Replace("\"", "\\\"").Replace("\r", "\\r").Replace("\n", "\\n");
        }
    }

    [DataContract]
    public class DirectLineToken
    {
        [DataMember(Name = "token")]
        public string Token { get; set; }

        [DataMember(Name = "expires_in")]
        public int ExpiresIn { get; set; }

        [DataMember(Name = "conversationId")]
        public string ConversationId { get; set; }
    }

    [DataContract]
    public class Conversation
    {
        [DataMember(Name = "conversationId")]
        public string ConversationId { get; set; }

        [DataMember(Name = "token")]
        public string Token { get; set; }

        [DataMember(Name = "expires_in")]
        public int ExpiresIn { get; set; }

        [DataMember(Name = "streamUrl")]
        public string StreamUrl { get; set; }
    }

