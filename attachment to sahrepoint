            tracingService.Trace("PrimaryEntityId: {0}", context.PrimaryEntityId);
            tracingService.Trace("Stage: {0}", context.Stage);
            tracingService.Trace("Mode: {0}", context.Mode);
            tracingService.Trace("Depth: {0}", context.Depth);
            tracingService.Trace("UserId: {0}", context.UserId);
            tracingService.Trace("InitiatingUserId: {0}", context.InitiatingUserId);
            tracingService.Trace("OwningExtension Id: {0}", context.OwningExtension?.Id);
            tracingService.Trace("OwningExtension Name: {0}", context.OwningExtension?.Name ?? "(null)");
            tracingService.Trace("IsExecutingOffline: {0}", context.IsExecutingOffline);
            tracingService.Trace("IsOfflinePlayback: {0}", context.IsOfflinePlayback);
            tracingService.Trace("IsolationMode: {0}", context.IsolationMode);
            tracingService.Trace("InputParameters Count: {0}", context.InputParameters?.Count ?? 0);
            tracingService.Trace("SharedVariables Count: {0}", context.SharedVariables?.Count ?? 0);
            tracingService.Trace("===============================================================");
        }

        private static string BuildTrackingName(string fileName, string opportunityName, Guid annotationId)
        {
            string safeFileName = string.IsNullOrWhiteSpace(fileName) ? "Attachment" : fileName.Trim();
            string safeOppName = string.IsNullOrWhiteSpace(opportunityName) ? "Opportunity" : opportunityName.Trim();

            string combined = $"{safeFileName} - {safeOppName}";

            if (combined.Length > 180)
            {
                combined = combined.Substring(0, 180).Trim();
            }

            if (string.IsNullOrWhiteSpace(combined))
            {
                combined = annotationId.ToString();
            }

            return combined;
        }
    }

