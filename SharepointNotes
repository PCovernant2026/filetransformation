Detailed processed and unprocessed attachments

SELECT
    CASE
        WHEN note_sync.ctp_notesharepointsyncid IS NOT NULL
            THEN 'Tracking Record Created'
        ELSE 'No Tracking Record'
    END AS [Solution Processing Status],

    annotation.annotationid AS [Annotation ID],
    annotation.objectid AS [Opportunity ID],
    opportunity.name AS [Opportunity Name],

    annotation.filename AS [File Name],
    annotation.mimetype AS [MIME Type],
    annotation.createdon AS [Attachment Created On],
    annotation.modifiedon AS [Attachment Modified On],
    annotation.createdbyname AS [Attachment Created By],
    annotation.modifiedbyname AS [Attachment Modified By],

    note_sync.ctp_notesharepointsyncid AS [Tracking Record ID],
    note_sync.createdon AS [Tracking Record Created On],
    note_sync.ctp_spsyncstatus AS [Sync Status Value],
    note_sync.ctp_targetfoldername AS [Target Folder],
    note_sync.ctp_sharepointfileurl AS [SharePoint File URL],
    note_sync.ctp_sharepointerror AS [SharePoint Error]

FROM annotation

INNER JOIN opportunity
    ON annotation.objectid = opportunity.opportunityid

LEFT JOIN ctp_notesharepointsync AS note_sync
    ON note_sync.ctp_annotationid =
       CONVERT(NVARCHAR(36), annotation.annotationid)

WHERE annotation.isdocument = 1
  AND annotation.createdon >= '2026-06-05T00:00:00'

ORDER BY
    [Solution Processing Status],
    annotation.createdon DESC;


Summary counts

SELECT
    CASE
        WHEN note_sync.ctp_notesharepointsyncid IS NOT NULL
            THEN 'Tracking Record Created'
        ELSE 'No Tracking Record'
    END AS [Solution Processing Status],

    COUNT(DISTINCT annotation.annotationid) AS [Attachment Count]

FROM annotation

INNER JOIN opportunity
    ON annotation.objectid = opportunity.opportunityid

LEFT JOIN ctp_notesharepointsync AS note_sync
    ON note_sync.ctp_annotationid =
       CONVERT(NVARCHAR(36), annotation.annotationid)

WHERE annotation.isdocument = 1
  AND annotation.createdon >= '2026-06-05T00:00:00'

GROUP BY
    CASE
        WHEN note_sync.ctp_notesharepointsyncid IS NOT NULL
            THEN 'Tracking Record Created'
        ELSE 'No Tracking Record'
    END;


