using System;
using Microsoft.Xrm.Sdk;

namespace VGS.Dynamics365.Plugins
{
    /// <summary>
    /// Plugin that creates two vgsd_holecalculations records when a vgsd_holedetails record is created.
    /// Register this plugin on the Create message of the vgsd_holedetails entity in PostOperation stage.
    /// It will set:
    /// - vgsd_holedetail lookup to the created hole detail
    /// - vgsd_workorderid if present
    /// - vgsd_concretetype (Finishing / Structural)
    /// </summary>
    public class Class1 : IPlugin
    {
        public void Execute(IServiceProvider serviceProvider)
        {
            if (serviceProvider == null) throw new ArgumentNullException(nameof(serviceProvider));

            var context = (IPluginExecutionContext)serviceProvider.GetService(typeof(IPluginExecutionContext));
            var tracing = (ITracingService)serviceProvider.GetService(typeof(ITracingService));
            var factory = (IOrganizationServiceFactory)serviceProvider.GetService(typeof(IOrganizationServiceFactory));
            var service = factory.CreateOrganizationService(context.UserId);

            try
            {
                // Validate target
                if (!context.InputParameters.Contains("Target") || !(context.InputParameters["Target"] is Entity target))
                {
                    tracing?.Trace("Target not found or invalid.");
                    return;
                }

                if (!string.Equals(target.LogicalName, "vgsd_holedetails", StringComparison.OrdinalIgnoreCase))
                {
                    tracing?.Trace($"Plugin invoked for entity '{target.LogicalName}', expected 'vgsd_holedetails'.");
                    return;
                }

                // Get created record ID
                Guid holeDetailId = Guid.Empty;

                if (context.OutputParameters != null && context.OutputParameters.Contains("id"))
                {
                    holeDetailId = (Guid)context.OutputParameters["id"];
                }
                else if (target.Id != Guid.Empty)
                {
                    holeDetailId = target.Id;
                }

                if (holeDetailId == Guid.Empty)
                {
                    tracing?.Trace("Could not determine created hole detail id.");
                    return;
                }

                // Get Work Order lookup if exists
                EntityReference workOrderRef = null;

                if (target.Contains("vgsd_workorderid") && target["vgsd_workorderid"] is EntityReference wref)
                {
                    workOrderRef = wref;
                }

                // OptionSet values
                const int FINISHING = 328980000;
                const int STRUCTURAL = 328980001;

                // Create two hole calculation records
                for (int i = 0; i < 2; i++)
                {
                    var calc = new Entity("vgsd_holecalculations");

                    // Link to hole detail
                    calc["vgsd_holedetail"] = new EntityReference("vgsd_holedetails", holeDetailId);

                    // Copy work order if present
                    if (workOrderRef != null)
                    {
                        calc["vgsd_workorderid"] = workOrderRef;
                    }

                    // Set concrete type
                    if (i == 0)
                    {
                        calc["vgsd_concretetype"] = new OptionSetValue(FINISHING);
                    }
                    else
                    {
                        calc["vgsd_concretetype"] = new OptionSetValue(STRUCTURAL);
                    }

                    // Optional naming
                    calc["vgsd_name"] = $"Hole Calculation {i + 1} for {holeDetailId:D}";

                    service.Create(calc);
                }
            }
            catch (Exception ex)
            {
                tracing?.Trace("Class1 plugin error: {0}", ex.ToString());
                throw;
            }
        }
    }
}
