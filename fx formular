        #region Helpers

        private static bool HasMinimumHoleCalcFields(Entity entity)
        {
            if (entity == null)
                return false;

            return entity.Contains(HoleCalculationToHoleDetailField)
                && entity.Contains(HoleCalculationProductField);
        }

        private static bool IsSupportedMessage(string messageName)
        {
            return string.Equals(messageName, "Create", StringComparison.OrdinalIgnoreCase)
                || string.Equals(messageName, "Update", StringComparison.OrdinalIgnoreCase)
                || string.Equals(messageName, "Delete", StringComparison.OrdinalIgnoreCase);
        }

        private static Entity GetPreImage(IPluginExecutionContext context, string imageName)
        {
            if (context.PreEntityImages != null && context.PreEntityImages.Contains(imageName))
                return context.PreEntityImages[imageName];

            return null;
        }

        private static Entity GetPostImage(IPluginExecutionContext context, string imageName)
        {
            if (context.PostEntityImages != null && context.PostEntityImages.Contains(imageName))
                return context.PostEntityImages[imageName];

            return null;
        }

        private static Guid GetCreatedRecordId(IPluginExecutionContext context, Entity targetEntity)
        {
            if (context.OutputParameters != null && context.OutputParameters.Contains("id"))
                return (Guid)context.OutputParameters["id"];

            if (targetEntity != null && targetEntity.Id != Guid.Empty)
                return targetEntity.Id;

            return Guid.Empty;
        }

        private static decimal GetDecimalValue(Entity entity, string attributeName)
        {
            if (entity == null || !entity.Contains(attributeName) || entity[attributeName] == null)
                return 0m;

            object value = entity[attributeName];

            if (value is decimal d) return d;
            if (value is double db) return Convert.ToDecimal(db);
            if (value is float f) return Convert.ToDecimal(f);
            if (value is int i) return Convert.ToDecimal(i);
            if (value is long l) return Convert.ToDecimal(l);
            if (value is Money m) return m.Value;

            decimal parsed;
            return decimal.TryParse(value.ToString(), out parsed) ? parsed : 0m;
        }

        private static IEnumerable<List<Guid>> Chunk(List<Guid> source, int size)
        {
            for (int i = 0; i < source.Count; i += size)
                yield return source.GetRange(i, Math.Min(size, source.Count - i));
        }

        private sealed class RecalcRequest
        {
            public Guid WorkOrderId { get; set; }
            public string ProductNumber { get; set; }
            public EntityReference ProductRef { get; set; }
        }

