function hasWindowsSeries(name) {
    let hasSeries = false;

    if (associatedWindowSeries.length == 0) {
        associatedWindowSeries = $("#WindowSeries")[0].children[0].querySelector('.view-grid').querySelector("table").querySelector("tbody").children
    } 

    for (let i = 0; i < associatedWindowSeries.length; i++) {
        if (associatedWindowSeries[i].innerText.replaceAll("  ", " ").trim() == name.replaceAll("  ", " ")) {
            hasSeries = true;
            break;
        }
    }

    return hasSeries
}

