using System;
using System.Collections.Generic;
using Microsoft.Xrm.Sdk;
using Microsoft.Xrm.Sdk.Query;

namespace VGS.Dynamics365.Plugins
{
    /// <summary>
    /// Creates vgsd_holecalculations records when a vgsd_holedetails record is created.
    ///
    /// Registration:
    /// - Message: Create
    /// - Primary Entity: vgsd_holedetails
    /// - Stage: PostOperation
    /// - Mode: Synchronous if users must see the created calculations immediately.
    ///         Asynchronous is also acceptable if performance/user wait time is more important.
    ///
    /// Logic:
    /// - Reads the Work Order from the created Hole Detail.
    /// - Reads Work Order Primary Incident Type: msdyn_primaryincidenttype.
    /// - Queries Incident Type Product: msdyn_incidenttypeproduct where:
    ///     - msdyn_incidenttype = Work Order Primary Incident Type
    ///     - configured CalculateHoleDetailsField = true
    ///     - statecode = Active when FilterIncidentTypeProductsToActive=true
    /// - Creates one Hole Calculation per unique product.
    /// - Prevents duplicates per Hole Detail + Product.
    /// - Optionally creates one productless default Hole Calculation when no matching products are found.
    ///
    /// Unsecure Configuration example:
    /// CalculateHoleDetailsField=vgsd_calculateholedetails;
    /// CreateDefaultCalculationWhenNoMatch=false;
    /// FilterIncidentTypeProductsToActive=true;
    /// NameMaxLength=100
    /// </summary>
    public class CreateHoleCalculationsOnHoleDetailCreate : IPlugin
    {
        private const string HoleDetailsEntityName = "vgsd_holedetails";
        private const string HoleCalculationsEntityName = "vgsd_holecalculations";
        private const string WorkOrderEntityName = "msdyn_workorder";

        // Incident Type Product fields
        private const string IncidentTypeProductEntityName = "msdyn_incidenttypeproduct";
        private const string ITP_IncidentTypeField = "msdyn_incidenttype";
        private const string ITP_ProductField = "msdyn_product";

        // Product fields
        private const string ProductEntityName = "product";
        private const string ProductIdField = "productid";
        private const string ProductNameField = "name";
        private const string ProductNumberField = "productnumber";

        // Hole Calculation fields
        private const string HoleDetailLookupField = "vgsd_holedetail";
        private const string WorkOrderField = "vgsd_workorderid";
        private const string ProductLookupField = "vgsd_product";
        private const string NameField = "vgsd_name";

        // Work Order fields
        private const string IncidentTypeField = "msdyn_primaryincidenttype";

        private const string StateCodeField = "statecode";
        private const int ActiveStateCode = 0;
        private const int PostOperationStage = 40;
        private const int DefaultNameMaxLength = 100;
        private const int QueryPageSize = 5000;

        private readonly string _calculateHoleDetailsField;
        private readonly bool _createDefaultCalculationWhenNoMatch;
        private readonly bool _filterIncidentTypeProductsToActive;
        private readonly int _nameMaxLength;

        public CreateHoleCalculationsOnHoleDetailCreate(string unsecureConfig, string secureConfig)
        {
            _calculateHoleDetailsField = "vgsd_calculateholedetails";
            _createDefaultCalculationWhenNoMatch = false;
            _filterIncidentTypeProductsToActive = true;
            _nameMaxLength = DefaultNameMaxLength;

            Dictionary<string, string> cfg = ParseConfig(unsecureConfig);

            if (cfg.TryGetValue("CalculateHoleDetailsField", out string calcField) &&
                !string.IsNullOrWhiteSpace(calcField))
            {
                _calculateHoleDetailsField = calcField.Trim();
            }

            if (cfg.TryGetValue("CreateDefaultCalculationWhenNoMatch", out string createDefault) &&
                TryParseBoolean(createDefault, out bool createDefaultBool))
            {
                _createDefaultCalculationWhenNoMatch = createDefaultBool;
            }

            if (cfg.TryGetValue("FilterIncidentTypeProductsToActive", out string filterActive) &&
                TryParseBoolean(filterActive, out bool filterActiveBool))
            {
                _filterIncidentTypeProductsToActive = filterActiveBool;
            }

            if (cfg.TryGetValue("NameMaxLength", out string nameMaxLengthText) &&
                int.TryParse(nameMaxLengthText, out int configuredNameMaxLength) &&
                configuredNameMaxLength >= 50 &&
                configuredNameMaxLength <= 850)
            {
                _nameMaxLength = configuredNameMaxLength;
            }
        }

        public CreateHoleCalculationsOnHoleDetailCreate() : this(null, null)
        {
        }

        public void Execute(IServiceProvider serviceProvider)
        {
            if (serviceProvider == null)
            {
                throw new ArgumentNullException(nameof(serviceProvider));
            }

            IPluginExecutionContext context = (IPluginExecutionContext)serviceProvider.GetService(typeof(IPluginExecutionContext));
            ITracingService tracing = (ITracingService)serviceProvider.GetService(typeof(ITracingService));
            IOrganizationServiceFactory factory = (IOrganizationServiceFactory)serviceProvider.GetService(typeof(IOrganizationServiceFactory));

            if (context == null)
            {
                throw new InvalidPluginExecutionException("Plugin execution context is null.");
            }

            if (factory == null)
            {
                throw new InvalidPluginExecutionException("Organization service factory is null.");
            }

            // Run as SYSTEM so the automation is not blocked by the creating user's table permissions.
            // If you want to enforce the user's security, change null to context.UserId.
            IOrganizationService service = factory.CreateOrganizationService(null);

            Trace(
                tracing,
                "CreateHoleCalculationsOnHoleDetailCreate started. Message={0}, PrimaryEntity={1}, Depth={2}, Mode={3}, Stage={4}",
                context.MessageName,
                context.PrimaryEntityName,
                context.Depth,
                context.Mode,
                context.Stage);

            try
            {
                if (!string.Equals(context.MessageName, "Create", StringComparison.OrdinalIgnoreCase))
                {
                    Trace(tracing, "Exiting: Message is not Create.");
                    return;
                }

                if (!string.Equals(context.PrimaryEntityName, HoleDetailsEntityName, StringComparison.OrdinalIgnoreCase))
                {
                    Trace(tracing, "Exiting: Primary entity is not {0}.", HoleDetailsEntityName);
                    return;
                }

                if (context.Stage != PostOperationStage)
                {
                    Trace(tracing, "Exiting: Plugin is not running in PostOperation. Current Stage={0}.", context.Stage);
                    return;
                }

                if (!context.InputParameters.Contains("Target") || !(context.InputParameters["Target"] is Entity))
                {
                    Trace(tracing, "Exiting: Target not found or invalid.");
                    return;
                }

                Entity target = (Entity)context.InputParameters["Target"];

                if (!string.Equals(target.LogicalName, HoleDetailsEntityName, StringComparison.OrdinalIgnoreCase))
                {
                    Trace(
                        tracing,
                        "Exiting: Target logical name {0} does not match expected {1}.",
                        target.LogicalName,
                        HoleDetailsEntityName);
                    return;
                }

                Guid holeDetailId = GetCreatedRecordId(context, target, tracing);

                if (holeDetailId == Guid.Empty)
                {
                    Trace(tracing, "Exiting: Could not determine created Hole Detail ID.");
                    return;
                }

                Trace(tracing, "Hole Detail ID resolved: {0}", holeDetailId);

                Entity holeDetail = RetrieveHoleDetailData(service, holeDetailId, target, tracing);
                EntityReference workOrderRef = holeDetail.GetAttributeValue<EntityReference>(WorkOrderField);

                if (workOrderRef == null || workOrderRef.Id == Guid.Empty)
                {
                    Trace(tracing, "No Work Order found on Hole Detail. No calculations will be created.");
                    return;
                }

                Trace(
                    tracing,
                    "Work Order found on Hole Detail. WorkOrderId={0}, WorkOrderName={1}",
                    workOrderRef.Id,
                    workOrderRef.Name ?? "null");

                EntityReference incidentTypeRef = GetPrimaryIncidentType(service, workOrderRef.Id, tracing);

                if (incidentTypeRef == null || incidentTypeRef.Id == Guid.Empty)
                {
                    Trace(tracing, "Work Order has no Primary Incident Type. No calculations will be created.");
                    return;
                }

                Trace(
                    tracing,
                    "Primary Incident Type found. IncidentTypeId={0}, IncidentTypeName={1}",
                    incidentTypeRef.Id,
                    incidentTypeRef.Name ?? "null");

                List<EntityReference> productsToCreate = GetUniqueProductsFromIncidentTypeProducts(
                    service,
                    incidentTypeRef.Id,
                    tracing);

                if (productsToCreate.Count > 0)
                {
                    Trace(tracing, "Found {0} unique product(s) flagged for Hole Calculations.", productsToCreate.Count);

                    foreach (EntityReference productRef in productsToCreate)
                    {
                        if (HoleCalculationExists(service, holeDetailId, productRef, tracing))
                        {
                            Trace(
                                tracing,
                                "Skipping create: Hole Calculation already exists for HoleDetailId={0}, ProductId={1}.",
                                holeDetailId,
                                productRef.Id);
                            continue;
                        }

                        string nameSuffix = !string.IsNullOrWhiteSpace(productRef.Name)
                            ? productRef.Name
                            : "Product";

                        CreateHoleCalculation(
                            service,
                            holeDetailId,
                            workOrderRef,
                            productRef,
                            "Hole Calculation - " + nameSuffix,
                            tracing);
                    }
                }
                else
                {
                    Trace(
                        tracing,
                        "No Incident Type Product rows flagged with {0}=true for IncidentTypeId={1}.",
                        _calculateHoleDetailsField,
                        incidentTypeRef.Id);

                    if (_createDefaultCalculationWhenNoMatch)
                    {
                        if (HoleCalculationExists(service, holeDetailId, null, tracing))
                        {
                            Trace(
                                tracing,
                                "Skipping default create: productless Hole Calculation already exists for HoleDetailId={0}.",
                                holeDetailId);
                            return;
                        }

                        Trace(tracing, "Creating default Hole Calculation with no product because CreateDefaultCalculationWhenNoMatch=true.");

                        CreateHoleCalculation(
                            service,
                            holeDetailId,
                            workOrderRef,
                            null,
                            "Hole Calculation",
                            tracing);
                    }
                    else
                    {
                        Trace(tracing, "No default calculation created because CreateDefaultCalculationWhenNoMatch=false.");
                    }
                }

                Trace(
                    tracing,
                    "CreateHoleCalculationsOnHoleDetailCreate completed successfully for Hole Detail {0}.",
                    holeDetailId);
            }
            catch (InvalidPluginExecutionException)
            {
                throw;
            }
            catch (Exception ex)
            {
                Trace(tracing, "CreateHoleCalculationsOnHoleDetailCreate error: {0}", ex.ToString());

                throw new InvalidPluginExecutionException(
                    "An error occurred while creating Hole Calculation records from the Hole Detail record. See Plugin Trace Log for details.",
                    ex);
            }
        }

        private Entity RetrieveHoleDetailData(
            IOrganizationService service,
            Guid holeDetailId,
            Entity target,
            ITracingService tracing)
        {
            if (target.Attributes.Contains(WorkOrderField))
            {
                Trace(tracing, "Target already contains Work Order field. No retrieve needed.");
                return target;
            }

            Trace(
                tracing,
                "Target does not contain Work Order field. Retrieving Hole Detail {0} from Dataverse.",
                holeDetailId);

            Entity retrieved = service.Retrieve(
                HoleDetailsEntityName,
                holeDetailId,
                new ColumnSet(WorkOrderField));

            Entity merged = new Entity(HoleDetailsEntityName) { Id = holeDetailId };

            foreach (KeyValuePair<string, object> attribute in target.Attributes)
            {
                merged[attribute.Key] = attribute.Value;
            }

            foreach (KeyValuePair<string, object> attribute in retrieved.Attributes)
            {
                merged[attribute.Key] = attribute.Value;
            }

            return merged;
        }

        private EntityReference GetPrimaryIncidentType(
            IOrganizationService service,
            Guid workOrderId,
            ITracingService tracing)
        {
            Trace(tracing, "Retrieving Work Order {0} to read Primary Incident Type.", workOrderId);

            Entity workOrder = service.Retrieve(
                WorkOrderEntityName,
                workOrderId,
                new ColumnSet(IncidentTypeField));

            EntityReference incidentTypeRef = workOrder.GetAttributeValue<EntityReference>(IncidentTypeField);

            if (incidentTypeRef == null)
            {
                Trace(tracing, "Work Order {0} does not have Primary Incident Type populated.", workOrderId);
            }

            return incidentTypeRef;
        }

        private List<EntityReference> GetUniqueProductsFromIncidentTypeProducts(
            IOrganizationService service,
            Guid incidentTypeId,
            ITracingService tracing)
        {
            var productsById = new Dictionary<Guid, EntityReference>();

            Trace(
                tracing,
                "Querying Incident Type Products. IncidentTypeId={0}, FlagField={1}, FilterActive={2}",
                incidentTypeId,
                _calculateHoleDetailsField,
                _filterIncidentTypeProductsToActive);

            QueryExpression query = new QueryExpression(IncidentTypeProductEntityName)
            {
                ColumnSet = new ColumnSet(ITP_ProductField),
                PageInfo = new PagingInfo
                {
                    Count = QueryPageSize,
                    PageNumber = 1,
                    ReturnTotalRecordCount = false
                }
            };

            query.Criteria.AddCondition(ITP_IncidentTypeField, ConditionOperator.Equal, incidentTypeId);
            query.Criteria.AddCondition(_calculateHoleDetailsField, ConditionOperator.Equal, true);

            if (_filterIncidentTypeProductsToActive)
            {
                query.Criteria.AddCondition(StateCodeField, ConditionOperator.Equal, ActiveStateCode);
            }

            LinkEntity productLink = query.AddLink(ProductEntityName, ITP_ProductField, ProductIdField, JoinOperator.LeftOuter);
            productLink.EntityAlias = "p";
            productLink.Columns = new ColumnSet(ProductNameField, ProductNumberField);

            while (true)
            {
                EntityCollection page = service.RetrieveMultiple(query);

                if (page == null || page.Entities.Count == 0)
                {
                    if (query.PageInfo.PageNumber == 1)
                    {
                        Trace(tracing, "No Incident Type Product rows found matching criteria.");
                    }

                    break;
                }

                foreach (Entity itp in page.Entities)
                {
                    EntityReference productRef = itp.GetAttributeValue<EntityReference>(ITP_ProductField);

                    if (productRef == null || productRef.Id == Guid.Empty)
                    {
                        Trace(tracing, "Incident Type Product row found but has no product. Skipping.");
                        continue;
                    }

                    string productName = GetAliasedString(itp, "p." + ProductNameField);

                    if (!string.IsNullOrWhiteSpace(productName))
                    {
                        productRef.Name = productName;
                    }

                    if (productsById.ContainsKey(productRef.Id))
                    {
                        Trace(
                            tracing,
                            "Duplicate Incident Type Product setup found for ProductId={0}. Keeping one Hole Calculation only.",
                            productRef.Id);
                        continue;
                    }

                    productsById.Add(productRef.Id, productRef);

                    Trace(
                        tracing,
                        "Incident Type Product match accepted. ProductId={0}, ProductName={1}",
                        productRef.Id,
                        productRef.Name ?? "null");
                }

                if (!page.MoreRecords)
                {
                    break;
                }

                query.PageInfo.PageNumber++;
                query.PageInfo.PagingCookie = page.PagingCookie;
            }

            return new List<EntityReference>(productsById.Values);
        }

        private static bool HoleCalculationExists(
            IOrganizationService service,
            Guid holeDetailId,
            EntityReference productRef,
            ITracingService tracing)
        {
            QueryExpression query = new QueryExpression(HoleCalculationsEntityName)
            {
                ColumnSet = new ColumnSet(false),
                TopCount = 1
            };

            query.Criteria.AddCondition(HoleDetailLookupField, ConditionOperator.Equal, holeDetailId);

            if (productRef != null && productRef.Id != Guid.Empty)
            {
                query.Criteria.AddCondition(ProductLookupField, ConditionOperator.Equal, productRef.Id);
            }
            else
            {
                query.Criteria.AddCondition(ProductLookupField, ConditionOperator.Null);
            }

            EntityCollection results = service.RetrieveMultiple(query);
            bool exists = results != null && results.Entities.Count > 0;

            Trace(
                tracing,
                "Duplicate check. HoleDetailId={0}, ProductId={1}, Exists={2}",
                holeDetailId,
                productRef != null ? productRef.Id.ToString() : "null",
                exists);

            return exists;
        }

        private void CreateHoleCalculation(
            IOrganizationService service,
            Guid holeDetailId,
            EntityReference workOrderRef,
            EntityReference productRef,
            string recordName,
            ITracingService tracing)
        {
            Entity holeCalculation = new Entity(HoleCalculationsEntityName);

            holeCalculation[HoleDetailLookupField] = new EntityReference(
                HoleDetailsEntityName,
                holeDetailId);

            if (workOrderRef != null && workOrderRef.Id != Guid.Empty)
            {
                holeCalculation[WorkOrderField] = workOrderRef;
            }

            if (productRef != null && productRef.Id != Guid.Empty)
            {
                holeCalculation[ProductLookupField] = productRef;
            }

            string safeName = BuildSafeName(recordName, holeDetailId, _nameMaxLength);
            holeCalculation[NameField] = safeName;

            Guid createdId = service.Create(holeCalculation);

            Trace(
                tracing,
                "Created Hole Calculation. Id={0}, HoleDetailId={1}, WorkOrderId={2}, ProductId={3}, ProductName={4}, Name={5}",
                createdId,
                holeDetailId,
                workOrderRef != null ? workOrderRef.Id.ToString() : "null",
                productRef != null ? productRef.Id.ToString() : "null",
                productRef != null ? productRef.Name ?? "null" : "null",
                safeName);
        }

        private static Guid GetCreatedRecordId(
            IPluginExecutionContext context,
            Entity target,
            ITracingService tracing)
        {
            if (context.OutputParameters != null &&
                context.OutputParameters.Contains("id") &&
                context.OutputParameters["id"] is Guid)
            {
                Guid id = (Guid)context.OutputParameters["id"];
                Trace(tracing, "Record ID obtained from OutputParameters: {0}", id);
                return id;
            }

            if (target != null && target.Id != Guid.Empty)
            {
                Trace(tracing, "Record ID obtained from Target.Id: {0}", target.Id);
                return target.Id;
            }

            Trace(tracing, "Unable to determine created record ID.");
            return Guid.Empty;
        }

        private static string GetAliasedString(Entity entity, string attributeName)
        {
            if (entity == null || string.IsNullOrWhiteSpace(attributeName) || !entity.Attributes.Contains(attributeName))
            {
                return null;
            }

            AliasedValue aliasedValue = entity[attributeName] as AliasedValue;
            return aliasedValue != null ? aliasedValue.Value as string : null;
        }

        private static string BuildSafeName(string recordName, Guid holeDetailId, int maxLength)
        {
            string prefix = string.IsNullOrWhiteSpace(recordName)
                ? "Hole Calculation"
                : recordName.Trim();

            string suffix = " - " + holeDetailId.ToString("D");

            if (maxLength <= suffix.Length)
            {
                return holeDetailId.ToString("D");
            }

            int maxPrefixLength = maxLength - suffix.Length;

            if (prefix.Length > maxPrefixLength)
            {
                prefix = prefix.Substring(0, maxPrefixLength).TrimEnd();
            }

            return prefix + suffix;
        }

        private static Dictionary<string, string> ParseConfig(string config)
        {
            var dict = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);

            if (string.IsNullOrWhiteSpace(config))
            {
                return dict;
            }

            string[] parts = config.Split(new[] { ';' }, StringSplitOptions.RemoveEmptyEntries);

            foreach (string part in parts)
            {
                string[] kv = part.Split(new[] { '=' }, 2, StringSplitOptions.RemoveEmptyEntries);

                if (kv.Length == 2 && !string.IsNullOrWhiteSpace(kv[0]))
                {
                    dict[kv[0].Trim()] = kv[1].Trim();
                }
            }

            return dict;
        }

        private static bool TryParseBoolean(string value, out bool result)
        {
            result = false;

            if (string.IsNullOrWhiteSpace(value))
            {
                return false;
            }

            string normalized = value.Trim();

            if (bool.TryParse(normalized, out result))
            {
                return true;
            }

            if (string.Equals(normalized, "1", StringComparison.OrdinalIgnoreCase) ||
                string.Equals(normalized, "yes", StringComparison.OrdinalIgnoreCase) ||
                string.Equals(normalized, "y", StringComparison.OrdinalIgnoreCase))
            {
                result = true;
                return true;
            }

            if (string.Equals(normalized, "0", StringComparison.OrdinalIgnoreCase) ||
                string.Equals(normalized, "no", StringComparison.OrdinalIgnoreCase) ||
                string.Equals(normalized, "n", StringComparison.OrdinalIgnoreCase))
            {
                result = false;
                return true;
            }

            return false;
        }

        private static void Trace(
            ITracingService tracing,
            string message,
            params object[] args)
        {
            if (tracing == null || string.IsNullOrWhiteSpace(message))
            {
                return;
            }

            if (args == null || args.Length == 0)
            {
                tracing.Trace(message);
            }
            else
            {
                tracing.Trace(message, args);
            }
        }
    }
}
