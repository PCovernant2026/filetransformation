        private static void TraceParameterNames(
            ITracingService tracingService,
            IPluginExecutionContext context)
        {
            if (context?.InputParameters == null)
            {
                Trace(tracingService, "Input parameter names: (none)");
                return;
            }

            string names = context.InputParameters.Count == 0
                ? "(none)"
                : string.Join(", ", context.InputParameters.Keys.OrderBy(k => k));

            Trace(tracingService, "Input parameter names: {0}", names);
        }

        private static void TraceEntityAttributes(
            ITracingService tracingService,
            Entity entity,
            string label)
        {
            if (entity == null)
            {
                Trace(tracingService, "{0}: Entity is null.", label);
                return;
            }

            Trace(
                tracingService,
                "----- {0}: LogicalName={1}, Id={2}, AttributeCount={3} -----",
                label,
                entity.LogicalName,
                entity.Id,
                entity.Attributes.Count);

            if (entity.Attributes.Count == 0)
            {
                Trace(tracingService, "{0}: No attributes present.", label);
                return;
            }

            foreach (var attribute in entity.Attributes.OrderBy(a => a.Key))
            {
                string formattedValue = FormatTraceValue(attribute.Key, attribute.Value);
                Trace(
                    tracingService,
                    "{0}.{1}={2}",
                    label,
                    attribute.Key,
                    formattedValue);
            }
        }

        private static string FormatTraceValue(string attributeName, object value)
        {
            if (value == null)
            {
                return "(null)";
            }

            if (string.Equals(
                attributeName,
                AnnotationFields.DocumentBody,
                StringComparison.OrdinalIgnoreCase))
            {
                string body = value as string;
                return body == null
                    ? "(non-string value)"
                    : $"[Base64 content omitted; Length={body.Length}]";
            }

            if (value is EntityReference entityReference)
            {
                return $"EntityReference({entityReference.LogicalName}, {entityReference.Id}, Name={entityReference.Name ?? "(null)"})";
            }

            if (value is OptionSetValue optionSetValue)
            {
                return $"OptionSetValue({optionSetValue.Value})";
            }

            if (value is Money money)
            {
                return $"Money({money.Value})";
            }

            if (value is AliasedValue aliasedValue)
            {
                return $"AliasedValue({FormatTraceValue(attributeName, aliasedValue.Value)})";
            }

            if (value is EntityCollection entityCollection)
            {
                return $"EntityCollection(Count={entityCollection.Entities.Count})";
            }

            if (value is byte[] bytes)
            {
                return $"ByteArray(Length={bytes.Length})";
            }

            if (value is string stringValue)
            {
                const int maxTraceLength = 500;

                if (stringValue.Length <= maxTraceLength)
                {
                    return stringValue;
                }

                return stringValue.Substring(0, maxTraceLength) +
                       $"...[truncated; TotalLength={stringValue.Length}]";
            }

            return value.ToString();
        }

        private static string BuildTrackingName(
            string fileName,
            string opportunityName,
            Guid annotationId)
        {
            string safeFileName =
                string.IsNullOrWhiteSpace(fileName)
                    ? "Attachment"
                    : fileName.Trim();

            string safeOppName =
                string.IsNullOrWhiteSpace(opportunityName)
                    ? "Opportunity"
                    : opportunityName.Trim();

            string combined = $"{safeFileName} - {safeOppName}";

            if (combined.Length > 180)
            {
                combined = combined.Substring(0, 180).Trim();
            }

            if (string.IsNullOrWhiteSpace(combined))
            {
                combined = annotationId.ToString();
            }

            return combined;
        }
    }

