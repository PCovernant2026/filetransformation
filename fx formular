function buildOptionSetValueHTMLTag(label, value, isCurrentlySelected, onlyShowIfSelected){
	var returnValue = "";
	
	if (isCurrentlySelected)
        returnValue = "<option selected='selected' value='" + value + "'>" + label + "</option>";
    else if(!onlyShowIfSelected)
        returnValue = "<option value='" + value + "'>" + label + "</option>";
	
	return returnValue;
}
