        private static string BuildProcessingRunId(IPluginExecutionContext context)
        {
            string suffix = Guid.NewGuid().ToString("N").Substring(0, 8).ToUpperInvariant();
            if (context != null && context.CorrelationId != Guid.Empty)
            {
                suffix = context.CorrelationId.ToString("N").Substring(0, 8).ToUpperInvariant();
            }

            return "RUN-" + DateTime.UtcNow.ToString("yyyyMMdd-HHmmss") + "-" + suffix;
        }

        private static string TryExtractStringValue(string requestJson, string propertyName)
        {
            if (string.IsNullOrWhiteSpace(requestJson) || string.IsNullOrWhiteSpace(propertyName)) return string.Empty;

            var match = Regex.Match(
                requestJson,
                "\"" + Regex.Escape(propertyName) + "\"\\s*:\\s*\"(?<value>(?:\\\\.|[^\"])*)\"",
                RegexOptions.IgnoreCase | RegexOptions.Singleline);

            if (!match.Success) return string.Empty;

            string literal = "\"" + match.Groups["value"].Value + "\"";
            string value = TryDeserializeJsonStringLiteral(literal);
            return value ?? match.Groups["value"].Value;
        }

        private static string EnsureTopLevelStringProperty(string requestJson, string propertyName, string propertyValue, ITracingService tracing)
        {
            if (string.IsNullOrWhiteSpace(requestJson)) return requestJson;
            if (string.IsNullOrWhiteSpace(propertyName)) return requestJson;

            if (!string.IsNullOrWhiteSpace(TryExtractStringValue(requestJson, propertyName)))
            {
                return requestJson;
            }

            string trimmed = requestJson.Trim();
            if (!LooksLikeJsonObject(trimmed)) return requestJson;

            string withoutClosingBrace = trimmed.Substring(0, trimmed.Length - 1).TrimEnd();
            string propertyJson = Quote(propertyName) + ":" + Quote(propertyValue ?? string.Empty);

            if (withoutClosingBrace.EndsWith("{", StringComparison.Ordinal))
            {
                string updatedEmptyObject = withoutClosingBrace + propertyJson + "}";
                if (tracing != null) tracing.Trace("Added top-level property to empty JSON request: " + propertyName);
                return updatedEmptyObject;
            }

            string updated = withoutClosingBrace + "," + propertyJson + "}";
            if (tracing != null) tracing.Trace("Added top-level property to JSON request: " + propertyName);
            return updated;
        }

