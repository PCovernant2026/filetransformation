using System;
using System.Collections.Generic;
using System.Linq;
using Microsoft.Xrm.Sdk;
using Microsoft.Xrm.Sdk.Query;

namespace VGS.Dynamics365.Plugins
{
    public sealed class RecalculateWorkOrderProductTotalsPlugin : IPlugin
    {
        #region Logical Names

        private const string HoleCalculationEntityName = "vgsd_holecalculations";
        private const string HoleDetailEntityName = "vgsd_holedetails";
        private const string WorkOrderEntityName = "msdyn_workorder";
        private const string WorkOrderProductEntityName = "msdyn_workorderproduct";
        private const string ProductEntityName = "product";

        private const string HoleCalculationToHoleDetailField = "vgsd_holedetail";
        private const string HoleCalculationProductField = "vgsd_product";
        private const string HoleCalculationVolumeField = "vgsd_volumecubicft"; // keep if this is your real logical name

        private const string HoleDetailToWorkOrderField = "vgsd_workorderid";

        private const string WorkOrderProductToWorkOrderField = "msdyn_workorder";
        private const string WorkOrderProductToProductField = "msdyn_product";
        private const string WorkOrderProductQuantityField = "msdyn_quantity";
        private const string WorkOrderProductNameField = "msdyn_name";

        private const string ProductNumberField = "productnumber";
        private const string ProductNameField = "name";

        private const string StateCodeField = "statecode";
        private const int ActiveStateCode = 0;

        #endregion

        #region Volume Conversion

        // Your source field is already cubic yards.
        private const bool SourceVolumeIsCubicFeet = false;
        private const decimal CubicFeetPerCubicYard = 27m;

        #endregion

        public void Execute(IServiceProvider serviceProvider)
        {
            if (serviceProvider == null)
            {
                throw new ArgumentNullException(nameof(serviceProvider));
            }

            var context = (IPluginExecutionContext)serviceProvider.GetService(typeof(IPluginExecutionContext));
            var tracing = (ITracingService)serviceProvider.GetService(typeof(ITracingService));
            var factory = (IOrganizationServiceFactory)serviceProvider.GetService(typeof(IOrganizationServiceFactory));
            var service = factory.CreateOrganizationService(context.UserId);

            tracing.Trace(
                "RecalculateWorkOrderProductTotalsPlugin started. Message={0}, PrimaryEntity={1}, Stage={2}, Mode={3}, Depth={4}, CorrelationId={5}",
                context.MessageName,
                context.PrimaryEntityName,
                context.Stage,
                context.Mode,
                context.Depth,
                context.CorrelationId);

            try
            {
                if (!IsSupportedMessage(context.MessageName))
                {
                    tracing.Trace("Exit: unsupported message.");
                    return;
                }

                if (!string.Equals(context.PrimaryEntityName, HoleCalculationEntityName, StringComparison.OrdinalIgnoreCase))
                {
                    tracing.Trace("Exit: primary entity is not {0}.", HoleCalculationEntityName);
                    return;
                }

                if (context.Depth > 2)
                {
                    tracing.Trace("Exit: plugin depth exceeded. Depth={0}", context.Depth);
                    return;
                }

                Entity targetEntity = null;
                EntityReference targetReference = null;

                if (context.InputParameters.Contains("Target"))
                {
                    targetEntity = context.InputParameters["Target"] as Entity;
                    targetReference = context.InputParameters["Target"] as EntityReference;
                }

                Entity preImage = GetPreImage(context, "PreImage");
                Entity postImage = GetPostImage(context, "PostImage");

                var impactedWorkOrderIds = new HashSet<Guid>();
                var impactedProductKeys = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
                var productCache = new Dictionary<Guid, ProductInfo>();

                switch (context.MessageName)
                {
                    case "Create":
                    {
                        Entity current = postImage ?? targetEntity;

                        if ((current == null || !current.Contains(HoleCalculationToHoleDetailField)) &&
                            targetEntity != null)
                        {
                            Guid createdId = GetCreatedRecordId(context, targetEntity);
                            if (createdId != Guid.Empty)
                            {
                                current = service.Retrieve(
                                    HoleCalculationEntityName,
                                    createdId,
                                    new ColumnSet(
                                        HoleCalculationToHoleDetailField,
                                        HoleCalculationProductField,
                                        HoleCalculationVolumeField));
                            }
                        }

                        Guid workOrderId = ResolveWorkOrderIdFromHoleCalculation(service, current, tracing);
                        string productKey = ResolveProductKeyFromHoleCalculation(service, current, productCache, tracing);

                        AddIfValid(impactedWorkOrderIds, workOrderId);
                        AddIfValid(impactedProductKeys, productKey);

                        break;
                    }

                    case "Update":
                    {
                        Entity oldRow = preImage;
                        Entity newRow = postImage ?? targetEntity;

                        if ((newRow == null || !newRow.Contains(HoleCalculationToHoleDetailField)) &&
                            targetEntity != null &&
                            targetEntity.Id != Guid.Empty)
                        {
                            newRow = service.Retrieve(
                                HoleCalculationEntityName,
                                targetEntity.Id,
                                new ColumnSet(
                                    HoleCalculationToHoleDetailField,
                                    HoleCalculationProductField,
                                    HoleCalculationVolumeField));
                        }

                        Guid oldWorkOrderId = ResolveWorkOrderIdFromHoleCalculation(service, oldRow, tracing);
                        Guid newWorkOrderId = ResolveWorkOrderIdFromHoleCalculation(service, newRow, tracing);

                        string oldProductKey = ResolveProductKeyFromHoleCalculation(service, oldRow, productCache, tracing);
                        string newProductKey = ResolveProductKeyFromHoleCalculation(service, newRow, productCache, tracing);

                        AddIfValid(impactedWorkOrderIds, oldWorkOrderId);
                        AddIfValid(impactedWorkOrderIds, newWorkOrderId);
                        AddIfValid(impactedProductKeys, oldProductKey);
                        AddIfValid(impactedProductKeys, newProductKey);

                        break;
                    }

                    case "Delete":
                    {
                        Entity oldRow = preImage;

                        if (oldRow == null && targetReference != null)
                        {
                            tracing.Trace("Delete step requires PreImage.");
                        }

                        Guid oldWorkOrderId = ResolveWorkOrderIdFromHoleCalculation(service, oldRow, tracing);
                        string oldProductKey = ResolveProductKeyFromHoleCalculation(service, oldRow, productCache, tracing);

                        AddIfValid(impactedWorkOrderIds, oldWorkOrderId);
                        AddIfValid(impactedProductKeys, oldProductKey);

                        break;
                    }
                }

                if (impactedWorkOrderIds.Count == 0)
                {
                    tracing.Trace("Exit: no impacted work orders found.");
                    return;
                }

                foreach (Guid workOrderId in impactedWorkOrderIds)
                {
                    RecalculateWorkOrderProducts(service, workOrderId, impactedProductKeys, productCache, tracing);
                }

                tracing.Trace("RecalculateWorkOrderProductTotalsPlugin completed successfully.");
            }
            catch (Exception ex)
            {
                tracing.Trace("RecalculateWorkOrderProductTotalsPlugin error: {0}", ex);
                throw new InvalidPluginExecutionException("An error occurred in RecalculateWorkOrderProductTotalsPlugin.", ex);
            }
        }

        #region Recalculation

        private static void RecalculateWorkOrderProducts(
            IOrganizationService service,
            Guid workOrderId,
            HashSet<string> impactedProductKeys,
            Dictionary<Guid, ProductInfo> productCache,
            ITracingService tracing)
        {
            tracing.Trace("Recalculating Work Order Products for Work Order {0}.", workOrderId);

            List<Guid> holeDetailIds = GetHoleDetailIdsForWorkOrder(service, workOrderId, tracing);
            var allHoleCalculations = new List<Entity>();

            if (holeDetailIds.Count > 0)
            {
                foreach (List<Guid> batch in Chunk(holeDetailIds, 200))
                {
                    var query = new QueryExpression(HoleCalculationEntityName)
                    {
                        ColumnSet = new ColumnSet(HoleCalculationProductField, HoleCalculationVolumeField)
                    };

                    query.Criteria.AddCondition(HoleCalculationToHoleDetailField, ConditionOperator.In, batch.Cast<object>().ToArray());
                    query.Criteria.AddCondition(HoleCalculationProductField, ConditionOperator.NotNull);
                    query.Criteria.AddCondition(HoleCalculationVolumeField, ConditionOperator.NotNull);
                    query.Criteria.AddCondition(StateCodeField, ConditionOperator.Equal, ActiveStateCode);

                    allHoleCalculations.AddRange(RetrieveAll(service, query));
                }
            }

            tracing.Trace(
                "Retrieved {0} Hole Calculation rows for Work Order {1}.",
                allHoleCalculations.Count,
                workOrderId);

            // Your requested pattern
            List<EntityReference> uniqueProducts = allHoleCalculations
                .Where(x => x.Contains(HoleCalculationProductField) && x[HoleCalculationProductField] is EntityReference)
                .Select(x => (EntityReference)x[HoleCalculationProductField])
                .GroupBy(x => x.Id)
                .Select(g => g.First())
                .ToList();

            var quantityByProductId = allHoleCalculations
                .Where(x => x.GetAttributeValue<EntityReference>(HoleCalculationProductField) != null)
                .GroupBy(x => x.GetAttributeValue<EntityReference>(HoleCalculationProductField).Id)
                .ToDictionary(
                    g => g.Key,
                    g => g.Sum(x => ConvertToCubicYards(GetDecimalValue(x, HoleCalculationVolumeField))));

            var totalsByProductKey = new Dictionary<string, decimal>(StringComparer.OrdinalIgnoreCase);
            var representativeProductRefs = new Dictionary<string, EntityReference>(StringComparer.OrdinalIgnoreCase);

            foreach (EntityReference productRef in uniqueProducts)
            {
                ProductInfo productInfo = GetProductInfo(service, productRef.Id, productCache, tracing);
                if (productInfo == null)
                {
                    tracing.Trace("Skipping product {0} because product info could not be loaded.", productRef.Id);
                    continue;
                }

                string productKey = GetProductKey(productInfo);
                if (string.IsNullOrWhiteSpace(productKey))
                {
                    productKey = productRef.Id.ToString("D");
                }

                decimal subtotal = quantityByProductId.ContainsKey(productRef.Id)
                    ? quantityByProductId[productRef.Id]
                    : 0m;

                if (!totalsByProductKey.ContainsKey(productKey))
                {
                    totalsByProductKey[productKey] = 0m;
                }

                totalsByProductKey[productKey] += subtotal;

                if (!representativeProductRefs.ContainsKey(productKey))
                {
                    representativeProductRefs[productKey] = new EntityReference(ProductEntityName, productInfo.ProductId)
                    {
                        Name = productInfo.ProductName
                    };
                }

                tracing.Trace(
                    "Subtotal -> WorkOrder={0}, ProductId={1}, ProductNumber={2}, ProductName={3}, Quantity={4}",
                    workOrderId,
                    productInfo.ProductId,
                    productInfo.ProductNumber ?? "(blank)",
                    productInfo.ProductName ?? "(blank)",
                    subtotal);
            }

            var productKeysToProcess = new HashSet<string>(totalsByProductKey.Keys, StringComparer.OrdinalIgnoreCase);

            if (impactedProductKeys != null)
            {
                foreach (string productKey in impactedProductKeys)
                {
                    AddIfValid(productKeysToProcess, productKey);
                }
            }

            foreach (string productKey in productKeysToProcess)
            {
                decimal quantity = totalsByProductKey.ContainsKey(productKey)
                    ? totalsByProductKey[productKey]
                    : 0m;

                EntityReference representativeProductRef = representativeProductRefs.ContainsKey(productKey)
                    ? representativeProductRefs[productKey]
                    : null;

                UpsertWorkOrderProduct(
                    service,
                    workOrderId,
                    productKey,
                    representativeProductRef,
                    quantity,
                    productCache,
                    tracing);
            }
        }

        #endregion

        #region Data Access

        private static List<Guid> GetHoleDetailIdsForWorkOrder(
            IOrganizationService service,
            Guid workOrderId,
            ITracingService tracing)
        {
            var ids = new List<Guid>();

            var query = new QueryExpression(HoleDetailEntityName)
            {
                ColumnSet = new ColumnSet(false)
            };

            query.Criteria.AddCondition(HoleDetailToWorkOrderField, ConditionOperator.Equal, workOrderId);
            query.Criteria.AddCondition(StateCodeField, ConditionOperator.Equal, ActiveStateCode);

            foreach (Entity row in RetrieveAll(service, query))
            {
                ids.Add(row.Id);
            }

            tracing.Trace("Found {0} Hole Detail rows for Work Order {1}.", ids.Count, workOrderId);
            return ids;
        }

        private static void UpsertWorkOrderProduct(
            IOrganizationService service,
            Guid workOrderId,
            string productKey,
            EntityReference representativeProductRef,
            decimal quantity,
            Dictionary<Guid, ProductInfo> productCache,
            ITracingService tracing)
        {
            Entity existingRow = null;

            // 1) Try exact product match
            if (representativeProductRef != null)
            {
                var exactSearch = new QueryExpression(WorkOrderProductEntityName)
                {
                    ColumnSet = new ColumnSet(WorkOrderProductQuantityField, WorkOrderProductNameField),
                    TopCount = 2
                };

                exactSearch.Criteria.AddCondition(WorkOrderProductToWorkOrderField, ConditionOperator.Equal, workOrderId);
                exactSearch.Criteria.AddCondition(WorkOrderProductToProductField, ConditionOperator.Equal, representativeProductRef.Id);
                exactSearch.Criteria.AddCondition(StateCodeField, ConditionOperator.Equal, ActiveStateCode);

                EntityCollection exactResults = service.RetrieveMultiple(exactSearch);

                if (exactResults.Entities.Count > 0)
                {
                    existingRow = exactResults.Entities[0];

                    if (exactResults.Entities.Count > 1)
                    {
                        tracing.Trace(
                            "Warning: multiple exact Work Order Product rows found. WorkOrder={0}, ProductId={1}",
                            workOrderId,
                            representativeProductRef.Id);
                    }
                }
            }

            // 2) Fallback by productnumber
            if (existingRow == null && !string.IsNullOrWhiteSpace(productKey))
            {
                var numberSearch = new QueryExpression(WorkOrderProductEntityName)
                {
                    ColumnSet = new ColumnSet(WorkOrderProductQuantityField, WorkOrderProductNameField),
                    TopCount = 2
                };

                numberSearch.Criteria.AddCondition(WorkOrderProductToWorkOrderField, ConditionOperator.Equal, workOrderId);
                numberSearch.Criteria.AddCondition(StateCodeField, ConditionOperator.Equal, ActiveStateCode);

                LinkEntity productLink = numberSearch.AddLink(
                    ProductEntityName,
                    WorkOrderProductToProductField,
                    "productid",
                    JoinOperator.Inner);

                productLink.LinkCriteria.AddCondition(ProductNumberField, ConditionOperator.Equal, productKey);

                EntityCollection numberResults = service.RetrieveMultiple(numberSearch);

                if (numberResults.Entities.Count > 0)
                {
                    existingRow = numberResults.Entities[0];

                    if (numberResults.Entities.Count > 1)
                    {
                        tracing.Trace(
                            "Warning: multiple Work Order Product rows found by productnumber. WorkOrder={0}, ProductNumber={1}",
                            workOrderId,
                            productKey);
                    }
                }
            }

            if (existingRow != null)
            {
                decimal existingQuantity = GetDecimalValue(existingRow, WorkOrderProductQuantityField);

                if (existingQuantity != quantity)
                {
                    var update = new Entity(WorkOrderProductEntityName, existingRow.Id);
                    update[WorkOrderProductQuantityField] = quantity;
                    service.Update(update);

                    tracing.Trace(
                        "Updated Work Order Product. Id={0}, WorkOrder={1}, ProductKey={2}, OldQuantity={3}, NewQuantity={4}",
                        existingRow.Id,
                        workOrderId,
                        productKey,
                        existingQuantity,
                        quantity);
                }
                else
                {
                    tracing.Trace(
                        "No quantity change needed. WorkOrderProductId={0}, ProductKey={1}, Quantity={2}",
                        existingRow.Id,
                        productKey,
                        quantity);
                }

                return;
            }

            if (quantity == 0m)
            {
                tracing.Trace(
                    "Skipping create because quantity is zero. WorkOrder={0}, ProductKey={1}",
                    workOrderId,
                    productKey);
                return;
            }

            EntityReference createProductRef = representativeProductRef;

            if (createProductRef == null && !string.IsNullOrWhiteSpace(productKey))
            {
                createProductRef = ResolveProductReferenceByProductNumber(service, productKey, productCache, tracing);
            }

            if (createProductRef == null)
            {
                tracing.Trace(
                    "Unable to resolve product reference for create. WorkOrder={0}, ProductKey={1}",
                    workOrderId,
                    productKey);
                return;
            }

            var create = new Entity(WorkOrderProductEntityName);
            create[WorkOrderProductToWorkOrderField] = new EntityReference(WorkOrderEntityName, workOrderId);
            create[WorkOrderProductToProductField] = createProductRef;
            create[WorkOrderProductQuantityField] = quantity;
            create[WorkOrderProductNameField] = $"Aggregated total for Work Order {workOrderId}";

            Guid createdId = service.Create(create);

            tracing.Trace(
                "Created Work Order Product. Id={0}, WorkOrder={1}, ProductId={2}, ProductKey={3}, Quantity={4}",
                createdId,
                workOrderId,
                createProductRef.Id,
                productKey,
                quantity);
        }

        #endregion

        #region Product Resolution

        private sealed class ProductInfo
        {
            public Guid ProductId { get; set; }
            public string ProductName { get; set; }
            public string ProductNumber { get; set; }
        }

        private static ProductInfo GetProductInfo(
            IOrganizationService service,
            Guid productId,
            Dictionary<Guid, ProductInfo> productCache,
            ITracingService tracing)
        {
            if (productId == Guid.Empty)
            {
                return null;
            }

            if (productCache.ContainsKey(productId))
            {
                return productCache[productId];
            }

            Entity product = service.Retrieve(
                ProductEntityName,
                productId,
                new ColumnSet(ProductNumberField, ProductNameField));

            var info = new ProductInfo
            {
                ProductId = product.Id,
                ProductName = product.GetAttributeValue<string>(ProductNameField),
                ProductNumber = product.GetAttributeValue<string>(ProductNumberField)
            };

            productCache[productId] = info;

            tracing.Trace(
                "Loaded product info. ProductId={0}, ProductNumber={1}, ProductName={2}",
                info.ProductId,
                info.ProductNumber ?? "(blank)",
                info.ProductName ?? "(blank)");

            return info;
        }

        private static string ResolveProductKeyFromHoleCalculation(
            IOrganizationService service,
            Entity holeCalculation,
            Dictionary<Guid, ProductInfo> productCache,
            ITracingService tracing)
        {
            if (holeCalculation == null)
            {
                return null;
            }

            EntityReference productRef = holeCalculation.GetAttributeValue<EntityReference>(HoleCalculationProductField);

            if (productRef == null &&
                holeCalculation.Id != Guid.Empty &&
                string.Equals(holeCalculation.LogicalName, HoleCalculationEntityName, StringComparison.OrdinalIgnoreCase))
            {
                Entity calc = service.Retrieve(
                    HoleCalculationEntityName,
                    holeCalculation.Id,
                    new ColumnSet(HoleCalculationProductField));

                productRef = calc.GetAttributeValue<EntityReference>(HoleCalculationProductField);
            }

            if (productRef == null)
            {
                tracing.Trace("ResolveProductKeyFromHoleCalculation: product not found.");
                return null;
            }

            ProductInfo info = GetProductInfo(service, productRef.Id, productCache, tracing);
            return GetProductKey(info);
        }

        private static string GetProductKey(ProductInfo info)
        {
            if (info == null)
            {
                return null;
            }

            if (!string.IsNullOrWhiteSpace(info.ProductNumber))
            {
                return info.ProductNumber;
            }

            return info.ProductId != Guid.Empty
                ? info.ProductId.ToString("D")
                : null;
        }

        private static EntityReference ResolveProductReferenceByProductNumber(
            IOrganizationService service,
            string productNumber,
            Dictionary<Guid, ProductInfo> productCache,
            ITracingService tracing)
        {
            if (string.IsNullOrWhiteSpace(productNumber))
            {
                return null;
            }

            var query = new QueryExpression(ProductEntityName)
            {
                ColumnSet = new ColumnSet(ProductNumberField, ProductNameField),
                TopCount = 1
            };

            query.Criteria.AddCondition(ProductNumberField, ConditionOperator.Equal, productNumber);
            query.Criteria.AddCondition(StateCodeField, ConditionOperator.Equal, ActiveStateCode);

            EntityCollection results = service.RetrieveMultiple(query);

            if (results.Entities.Count == 0)
            {
                tracing.Trace("ResolveProductReferenceByProductNumber: no product found for productnumber {0}", productNumber);
                return null;
            }

            Entity product = results.Entities[0];

            var info = new ProductInfo
            {
                ProductId = product.Id,
                ProductName = product.GetAttributeValue<string>(ProductNameField),
                ProductNumber = product.GetAttributeValue<string>(ProductNumberField)
            };

            productCache[product.Id] = info;

            return new EntityReference(ProductEntityName, product.Id)
            {
                Name = info.ProductName
            };
        }

        #endregion

        #region Resolution Helpers

        private static Guid ResolveWorkOrderIdFromHoleCalculation(
            IOrganizationService service,
            Entity holeCalculation,
            ITracingService tracing)
        {
            if (holeCalculation == null)
            {
                tracing.Trace("ResolveWorkOrderIdFromHoleCalculation: source row is null.");
                return Guid.Empty;
            }

            EntityReference holeDetailRef = holeCalculation.GetAttributeValue<EntityReference>(HoleCalculationToHoleDetailField);

            if (holeDetailRef == null &&
                holeCalculation.Id != Guid.Empty &&
                string.Equals(holeCalculation.LogicalName, HoleCalculationEntityName, StringComparison.OrdinalIgnoreCase))
            {
                Entity calc = service.Retrieve(
                    HoleCalculationEntityName,
                    holeCalculation.Id,
                    new ColumnSet(HoleCalculationToHoleDetailField));

                holeDetailRef = calc.GetAttributeValue<EntityReference>(HoleCalculationToHoleDetailField);
            }

            if (holeDetailRef == null)
            {
                tracing.Trace("ResolveWorkOrderIdFromHoleCalculation: hole detail not found.");
                return Guid.Empty;
            }

            Entity holeDetail = service.Retrieve(
                HoleDetailEntityName,
                holeDetailRef.Id,
                new ColumnSet(HoleDetailToWorkOrderField));

            EntityReference workOrderRef = holeDetail.GetAttributeValue<EntityReference>(HoleDetailToWorkOrderField);

            if (workOrderRef == null)
            {
                tracing.Trace(
                    "ResolveWorkOrderIdFromHoleCalculation: work order not found on hole detail {0}.",
                    holeDetailRef.Id);
                return Guid.Empty;
            }

            return workOrderRef.Id;
        }

        #endregion

        #region Helpers

        private static bool IsSupportedMessage(string messageName)
        {
            return string.Equals(messageName, "Create", StringComparison.OrdinalIgnoreCase)
                || string.Equals(messageName, "Update", StringComparison.OrdinalIgnoreCase)
                || string.Equals(messageName, "Delete", StringComparison.OrdinalIgnoreCase);
        }

        private static Entity GetPreImage(IPluginExecutionContext context, string imageName)
        {
            if (context.PreEntityImages != null && context.PreEntityImages.Contains(imageName))
            {
                return context.PreEntityImages[imageName];
            }

            return null;
        }

        private static Entity GetPostImage(IPluginExecutionContext context, string imageName)
        {
            if (context.PostEntityImages != null && context.PostEntityImages.Contains(imageName))
            {
                return context.PostEntityImages[imageName];
            }

            return null;
        }

        private static Guid GetCreatedRecordId(IPluginExecutionContext context, Entity targetEntity)
        {
            if (context.OutputParameters != null && context.OutputParameters.Contains("id"))
            {
                return (Guid)context.OutputParameters["id"];
            }

            if (targetEntity != null && targetEntity.Id != Guid.Empty)
            {
                return targetEntity.Id;
            }

            return Guid.Empty;
        }

        private static void AddIfValid(HashSet<Guid> set, Guid value)
        {
            if (value != Guid.Empty)
            {
                set.Add(value);
            }
        }

        private static void AddIfValid(HashSet<string> set, string value)
        {
            if (!string.IsNullOrWhiteSpace(value))
            {
                set.Add(value);
            }
        }

        private static decimal ConvertToCubicYards(decimal sourceVolume)
        {
            if (!SourceVolumeIsCubicFeet)
            {
                return sourceVolume;
            }

            return sourceVolume / CubicFeetPerCubicYard;
        }

        private static decimal GetDecimalValue(Entity entity, string attributeName)
        {
            if (entity == null || !entity.Contains(attributeName) || entity[attributeName] == null)
            {
                return 0m;
            }

            object value = entity[attributeName];

            if (value is decimal d) return d;
            if (value is double db) return Convert.ToDecimal(db);
            if (value is float f) return Convert.ToDecimal(f);
            if (value is int i) return Convert.ToDecimal(i);
            if (value is long l) return Convert.ToDecimal(l);
            if (value is Money m) return m.Value;

            decimal parsed;
            return decimal.TryParse(value.ToString(), out parsed) ? parsed : 0m;
        }

        private static List<Entity> RetrieveAll(IOrganizationService service, QueryExpression query)
        {
            var results = new List<Entity>();

            if (query.PageInfo == null)
            {
                query.PageInfo = new PagingInfo
                {
                    PageNumber = 1,
                    Count = 5000
                };
            }

            while (true)
            {
                EntityCollection page = service.RetrieveMultiple(query);
                results.AddRange(page.Entities);

                if (!page.MoreRecords)
                {
                    break;
                }

                query.PageInfo.PageNumber++;
                query.PageInfo.PagingCookie = page.PagingCookie;
            }

            return results;
        }

        private static IEnumerable<List<Guid>> Chunk(List<Guid> source, int size)
        {
            for (int i = 0; i < source.Count; i += size)
            {
                yield return source.GetRange(i, Math.Min(size, source.Count - i));
            }
        }

        #endregion
    }
