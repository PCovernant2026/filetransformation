<body>
  <div id="root"></div>

  <script>
    "use strict";

    const CTP_CONFIG = {
      runtime: {
        mode: "dataverseCustomApi", // "mock" | "agentProxy" | "dataverseCustomApi"
        agentProxyUrl: "",
        dataverseCustomApiName: "ctp_InvokeVendorQuoteAgent",
        dataverseRequestParamName: "ctp_RequestJson",
        dataverseResponseParamName: "ctp_ResponseJson",
        timeoutMs: 120000
      },
      agent: {
        name: "CTP Vendor Quote Agent",
        version: "2.4.0-embedded-portal-custom-api"
      },
      file: {
        allowLocalFileBase64: true,
        maxLocalFileBytes: 4 * 1024 * 1024,
        acceptedExtensions: ["pdf", "xlsx", "xls", "csv", "docx", "doc", "png", "jpg", "jpeg", "txt"]
      },
      dataverse: {
        stagingEntityLogicalName: "ctp_vendorquotestaging"
      }
    };

    const sampleResponse = {
      success: true,
      status: "Requires Review",
      message: "I mapped the vendor quote into the standard CTP payload. Five lines need review before Opportunity Products are created.",
      payload: {
        header: {
          opportunityId: "00000000-0000-0000-0000-000000000000",
          opportunityName: "UMC Discovery Ridge - 100kW UPS",
          vendorName: "Schneider Electric IT Corporation",
          quoteNumber: "ISX0002642109-0007",
          fileName: "UMC Discovery Ridge 100kW UPS 5-28-26 1.docx",
          fileUrl: "SharePoint or Dataverse file reference",
          currency: "USD",
          confidence: 0.72
        },
        lines: [
          { lineNumber: 1, vendorSku: null, productName: "Galaxy VS UPS 100kW 480V", description: "Galaxy VS UPS 100kW 480V for External Batteries, Start-up 5x8", quantity: 1, unitOfMeasure: "Each", vendorUnitCost: null, matchStatus: "Unmatched", matchConfidence: 0.46, reason: "No SKU found. Description match requires review." },
          { lineNumber: 2, vendorSku: null, productName: "Galaxy VS Air Filter Kit", description: "Galaxy VS Air Filter Kit for 521mm wide UPS", quantity: 1, unitOfMeasure: "Each", vendorUnitCost: null, matchStatus: "Unmatched", matchConfidence: 0.42, reason: "No SKU found. Awaiting product mapping." },
          { lineNumber: 3, vendorSku: null, productName: "Galaxy VS Seismic Kit", description: "Galaxy VS Seismic Kit for Modular Battery Cabinet or 521mm wide UPS", quantity: 2, unitOfMeasure: "Each", vendorUnitCost: null, matchStatus: "Low Confidence", matchConfidence: 0.61, reason: "Possible match found but confidence is below threshold." },
          { lineNumber: 4, vendorSku: null, productName: "Galaxy VS Maintenance Bypass Cabinet", description: "Maintenance Bypass Cabinet, UL, Single-Unit 50-75kW 208V, 100-150kW 480V", quantity: 1, unitOfMeasure: "Each", vendorUnitCost: null, matchStatus: "Low Confidence", matchConfidence: 0.58, reason: "Model found similar products; human review recommended." },
          { lineNumber: 5, vendorSku: null, productName: "1 Year 4HR 7X24 Response Upgrade", description: "Service Contract for 41 to 150 kVA", quantity: 1, unitOfMeasure: "Each", vendorUnitCost: null, matchStatus: "Unmatched", matchConfidence: 0.35, reason: "Service line needs manual mapping or write-in approval." }
        ]
      }
    };

    const state = {
      opportunity: null,
      selectedFile: null,
      fileBase64: null,
      fileReference: "",
      vendorHint: "",
      instruction: "",
      activeTab: "lines",
      response: null,
      approved: false,
      busy: false,
      error: "",
      toast: "",
      isDragging: false,
      unsavedLineChanges: false,
      progressStage: "quote",
      progressText: "Waiting for quote file or file reference."
    };

    const root = document.getElementById("root");
    const byId = (id) => document.getElementById(id);

    function esc(v) {
      return String(v ?? "")
        .replaceAll("&", "&amp;")
        .replaceAll("<", "&lt;")
        .replaceAll(">", "&gt;")
        .replaceAll('"', "&quot;")
        .replaceAll("'", "&#039;");
    }

    function pretty(v) {
      try { return JSON.stringify(v, null, 2); } catch { return String(v ?? ""); }
    }

    function normalizeGuid(v) {
      return String(v || "").replace(/[{}]/g, "").trim();
    }

    function getXrm() {
      try { return window.parent && window.parent.Xrm ? window.parent.Xrm : window.Xrm || null; }
      catch { return null; }
    }

    function readOpportunityContext() {
      const xrm = getXrm();
      let id = "", name = "Current Opportunity", entityName = "opportunity", clientUrl = "";
      try {
        if (xrm?.Utility?.getGlobalContext) clientUrl = xrm.Utility.getGlobalContext().getClientUrl();
        if (xrm?.Page?.data?.entity) {
          id = normalizeGuid(xrm.Page.data.entity.getId());
          entityName = xrm.Page.data.entity.getEntityName?.() || entityName;
          const nameAttr = xrm.Page.getAttribute?.("name");
          name = nameAttr?.getValue?.() || name;
        }
      } catch { }

      const params = new URLSearchParams(window.location.search || "");
      id = id || normalizeGuid(params.get("id"));
      name = params.get("name") || name;
      entityName = params.get("typename") || entityName;

      return { id: id || "00000000-0000-0000-0000-000000000000", name, entityName, clientUrl, source: id ? "Dynamics form" : "Preview" };
    }

    function setState(next) { Object.assign(state, next); render(); }

    function showToast(msg) {
      state.toast = msg;
      render();
      clearTimeout(showToast.timer);
      showToast.timer = setTimeout(() => setState({ toast: "" }), 3800);
    }

    function fmtBytes(bytes) {
      if (!bytes && bytes !== 0) return "";
      if (bytes < 1024) return bytes + " B";
      if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(1) + " KB";
      return (bytes / 1024 / 1024).toFixed(1) + " MB";
    }

    function lines() { return state.response?.payload?.lines || []; }
    function header() { return state.response?.payload?.header || {}; }

    function countStatus(type) {
      const t = type.toLowerCase();
      return lines().filter(l => String(l.matchStatus || "").toLowerCase().includes(t)).length;
    }

    function needsReviewCount() {
      return lines().filter(l => {
        const s = String(l.matchStatus || "").toLowerCase();
        return s.includes("unmatched") || s.includes("low");
      }).length;
    }

    function statusClass(s) {
      const v = String(s || "").toLowerCase();
      if (v.includes("created") || v.includes("approved")) return "success";
      if (v.includes("review") || v.includes("waiting")) return "warn";
      if (v.includes("fail") || v.includes("error")) return "danger";
      return "";
    }

    function chipClass(s) {
      const v = String(s || "").toLowerCase();
      if (v.includes("matched") && !v.includes("unmatched")) return "matched";
      if (v.includes("unmatched")) return "unmatched";
      if (v.includes("low")) return "low";
      if (v.includes("fail")) return "failed";
      return "";
    }


    function normalizeAgentResponse(response) {
      if (!response || !response.payload) return response;
      if (!Array.isArray(response.payload.lines)) response.payload.lines = [];
      response.payload.lines = response.payload.lines.map((line, index) => ({
        lineNumber: line.lineNumber ?? index + 1,
        vendorSku: line.vendorSku ?? line.sku ?? null,
        productName: line.productName ?? "",
        description: line.description ?? line.productName ?? "",
        quantity: line.quantity ?? 1,
        unitOfMeasure: line.unitOfMeasure ?? line.uom ?? "Each",
        vendorUnitCost: line.vendorUnitCost ?? null,
        vendorExtendedCost: line.vendorExtendedCost ?? null,
        matchStatus: line.matchStatus ?? "Unmatched",
        matchConfidence: line.matchConfidence ?? null,
        useWriteInProduct: !!line.useWriteInProduct,
        userApproved: !!line.userApproved,
        userModified: !!line.userModified,
        reviewDecision: line.reviewDecision || (line.userApproved ? "Approved" : "Pending Review"),
        reason: line.reason ?? "",
        ...line
      }));
      return response;
    }

    function approvedLineCount() {
      return lines().filter(l => !!l.userApproved).length;
    }

    function allLinesApproved() {
      const current = lines();
      return current.length > 0 && current.every(l => !!l.userApproved);
    }

    function toNumberOrNull(value) {
      if (value === null || value === undefined || String(value).trim() === "") return null;
      const n = Number(value);
      return Number.isFinite(n) ? n : null;
    }

    function toNumberOrZero(value) {
      const n = Number(value);
      return Number.isFinite(n) ? n : 0;
    }

    async function fileToBase64(file) {
      return new Promise((resolve, reject) => {
        const r = new FileReader();
        r.onload = () => resolve(String(r.result || "").split(",")[1] || "");
        r.onerror = () => reject(r.error);
        r.readAsDataURL(file);
      });
    }

    function isAcceptedFile(file) {
      if (!file || !file.name) return false;
      const ext = file.name.split(".").pop().toLowerCase();
      return CTP_CONFIG.file.acceptedExtensions.includes(ext);
    }

    async function handleSelectedFile(file) {
      if (!file) return;
      if (!isAcceptedFile(file)) {
        showToast("Unsupported file type. Use PDF, Excel, CSV, DOCX, image, or TXT files.");
        return;
      }

      state.selectedFile = file;
      state.fileBase64 = null;
      state.error = "";
      state.response = null;
      state.approved = false;
      state.unsavedLineChanges = false;
      state.isDragging = false;
      state.progressStage = "quote";
      state.progressText = "Quote selected. Agent is ready to extract and map.";

      if (CTP_CONFIG.file.allowLocalFileBase64 && file.size <= CTP_CONFIG.file.maxLocalFileBytes) {
        try { state.fileBase64 = await fileToBase64(file); } catch { }
      }

      render();
      showToast(`Selected ${file.name}. Ask the agent to process it when ready.`);
    }

    async function onFileChange(e) {
      const file = e.target.files?.[0];
      await handleSelectedFile(file);
    }

    function setDropVisual(isDragging) {
      state.isDragging = isDragging;
      const zone = byId("dropzone");
      if (zone) zone.classList.toggle("dragging", isDragging);
    }

    function onDropZoneClick(e) {
      if (e.target && e.target.id === "fileInput") return;
      byId("fileInput")?.click();
    }

    function onDropZoneKeydown(e) {
      if (e.key === "Enter" || e.key === " ") {
        e.preventDefault();
        byId("fileInput")?.click();
      }
    }

    function onDropZoneDragOver(e) {
      e.preventDefault();
      e.stopPropagation();
      if (e.dataTransfer) e.dataTransfer.dropEffect = "copy";
      setDropVisual(true);
    }

    function onDropZoneDragLeave(e) {
      e.preventDefault();
      e.stopPropagation();
      const zone = byId("dropzone");
      if (zone && e.relatedTarget && zone.contains(e.relatedTarget)) return;
      setDropVisual(false);
    }

    async function onDropZoneDrop(e) {
      e.preventDefault();
      e.stopPropagation();
      setDropVisual(false);
      const file = e.dataTransfer?.files?.[0];
      await handleSelectedFile(file);
    }

    function buildRequest(operation) {
      return {
        operation,
        source: "Dynamics 365 Opportunity HTML Web Resource",
        agentName: CTP_CONFIG.agent.name,
        timestampUtc: new Date().toISOString(),
        opportunity: state.opportunity,
        file: {
          fileName: state.selectedFile?.name || "",
          mimeType: state.selectedFile?.type || "",
          sizeBytes: state.selectedFile?.size || 0,
          fileReference: state.fileReference,
          localFileBase64: state.fileBase64
        },
        hints: { vendorName: state.vendorHint, instruction: state.instruction },
        currentPayload: state.response?.payload || null,
        approval: {
          approved: state.approved,
          approvedOnUtc: state.approved ? new Date().toISOString() : null,
          approvedLineCount: approvedLineCount(),
          totalLineCount: lines().length,
          allLinesApproved: allLinesApproved()
        }
      };
    }

    function validate(operation) {
      if (operation === "extract_map_preview" && !state.selectedFile && !state.fileReference) {
        throw new Error("Select a quote file or provide a file reference before asking the agent to process it.");
      }
      if (operation === "approve_create_products" && !state.response?.payload) {
        throw new Error("Ask the agent to extract and map the quote first.");
      }
      if (operation === "approve_create_products" && state.unsavedLineChanges) {
        throw new Error("Save the line-item edits before creating Opportunity Product Lines.");
      }
      if (operation === "approve_create_products" && !allLinesApproved()) {
        throw new Error("Approve each line item before creating Opportunity Product Lines. Use Approve all lines if every line is correct.");
      }
      if (operation === "approve_create_products" && !state.approved) {
        throw new Error("Confirm that you reviewed and approve the mapped quote before creating Opportunity Product Lines.");
      }
    }

    function startProgress(operation) {
      if (operation === "approve_create_products") {
        return { stage: "creating", text: "Agent is creating the staging audit snapshot and Opportunity Product Lines." };
      }
      if (operation === "refresh_mapping") {
        return { stage: "mapping", text: "Agent is refreshing product mapping and validation." };
      }
      return { stage: "mapping", text: "Agent is reading the quote, extracting content, and generating the mapped payload." };
    }

    function finishProgress(operation, response) {
      const status = String(response?.status || "").toLowerCase();
      if (operation === "approve_create_products" || status.includes("created")) {
        return { stage: "created", text: "Opportunity Product Lines were created and linked to the staging audit snapshot." };
      }
      return { stage: "review", text: "Agent mapping is ready. Review the mapped lines before approval." };
    }

    function inferredStage(hasPayload, isCreated) {
      if (state.busy) return state.progressStage;
      if (isCreated) return "created";
      if (state.approved) return "approved";
      if (hasPayload) return "review";
      if (state.selectedFile || state.fileReference) return "quote";
      return state.progressStage || "quote";
    }

    function stepClass(step, hasPayload, isCreated) {
      const stage = inferredStage(hasPayload, isCreated);
      const hasQuote = !!state.selectedFile || !!state.fileReference;
      const isBusy = !!state.busy;
      let cls = "step";

      if (step === 1) {
        if (hasQuote || hasPayload || isCreated) cls += " done";
        else cls += " active";
      }

      if (step === 2) {
        if (stage === "mapping") cls += isBusy ? " processing" : " active";
        else if (hasPayload || stage === "review" || stage === "approved" || stage === "creating" || stage === "created") cls += " done";
        else if (hasQuote) cls += " active";
      }

      if (step === 3) {
        if (stage === "review") cls += " active";
        if (state.approved || stage === "approved" || stage === "creating" || stage === "created") cls += " done";
      }

      if (step === 4) {
        if (stage === "creating") cls += isBusy ? " processing" : " active";
        else if (isCreated || stage === "created") cls += " done";
      }

      return cls;
    }

    function progressCaptionClass(hasPayload, isCreated) {
      if (state.error) return "error";
      if (isCreated) return "done";
      if (!state.busy && !hasPayload && !state.selectedFile && !state.fileReference) return "idle";
      return "";
    }

    function progressCaptionText(hasPayload, isCreated) {
      if (state.error) return "Processing stopped. Fix the error and try again.";
      if (state.progressText) return state.progressText;
      if (isCreated) return "Opportunity Product Lines created.";
      if (state.approved) return "Approved. Ready to create Opportunity Product Lines.";
      if (hasPayload) return "Review mapped quote lines before approval.";
      if (state.selectedFile || state.fileReference) return "Quote selected. Agent is ready to process.";
      return "Waiting for quote file or file reference.";
    }

    async function askAgent(operation) {
      try {
        validate(operation);
        const progress = startProgress(operation);
        setState({ busy: true, error: "", progressStage: progress.stage, progressText: progress.text });
        const request = buildRequest(operation);
        let response;
        if (CTP_CONFIG.runtime.mode === "mock") response = await mockAgent(operation, request);
        else if (CTP_CONFIG.runtime.mode === "agentProxy") response = await callAgentProxy(request);
        else if (CTP_CONFIG.runtime.mode === "dataverseCustomApi") response = await callCustomApi(request);
        else throw new Error("Unsupported runtime mode: " + CTP_CONFIG.runtime.mode);
        if (!response || response.success === false) throw new Error(response?.message || "Agent returned an unsuccessful response.");
        response = normalizeAgentResponse(response);
        const doneProgress = finishProgress(operation, response);
        setState({
          busy: false,
          response,
          approved: operation === "approve_create_products" ? state.approved : false,
          unsavedLineChanges: false,
          activeTab: operation === "approve_create_products" ? "result" : "lines",
          progressStage: doneProgress.stage,
          progressText: doneProgress.text
        });
        showToast(response.message || "Agent completed the request.");
      } catch (err) {
        setState({ busy: false, error: err.message || String(err), progressStage: "error", progressText: "Processing stopped. Fix the error and try again." });
      }
    }

    async function mockAgent(operation, request) {
      await new Promise(r => setTimeout(r, 750));
      if (operation === "approve_create_products") {
        return {
          success: true,
          status: "Opportunity Products Created",
          message: "Approved. I created the staging audit snapshot and Opportunity Product Lines. This is mock mode.",
          payload: state.response.payload,
          result: {
            vendorQuoteStagingId: "9db6b7d2-8ac0-4a24-9be7-1fcfbd1a5c9f",
            stagingLinesCreated: lines().length,
            opportunityProductLinesCreated: lines().length,
            approvedOnUtc: new Date().toISOString()
          }
        };
      }
      const res = JSON.parse(JSON.stringify(sampleResponse));
      res.payload.header.opportunityId = request.opportunity.id;
      res.payload.header.opportunityName = request.opportunity.name;
      res.payload.header.fileName = request.file.fileName || res.payload.header.fileName;
      res.payload.header.fileUrl = request.file.fileReference || res.payload.header.fileUrl;
      if (request.hints.vendorName) res.payload.header.vendorName = request.hints.vendorName;
      return res;
    }

    async function callAgentProxy(request) {
      if (!CTP_CONFIG.runtime.agentProxyUrl) throw new Error("Agent proxy URL is not configured.");
      const controller = new AbortController();
      const timer = setTimeout(() => controller.abort(), CTP_CONFIG.runtime.timeoutMs);
      try {
        const res = await fetch(CTP_CONFIG.runtime.agentProxyUrl, {
          method: "POST",
          credentials: "include",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(request),
          signal: controller.signal
        });
        const text = await res.text();
        const json = text ? JSON.parse(text) : {};
        if (!res.ok) throw new Error(json.message || "Agent proxy HTTP " + res.status);
        return json;
      } finally { clearTimeout(timer); }
    }

    async function callCustomApi(request) {
      const xrm = getXrm();
      if (!xrm?.WebApi?.online?.execute) throw new Error("Xrm.WebApi.online.execute is not available. Open this inside Dynamics 365.");
      const p = CTP_CONFIG.runtime.dataverseRequestParamName;
      const out = CTP_CONFIG.runtime.dataverseResponseParamName;
      const apiRequest = { [p]: JSON.stringify(request) };
      apiRequest.getMetadata = () => ({
        boundParameter: null,
        parameterTypes: { [p]: { typeName: "Edm.String", structuralProperty: 1 } },
        operationType: 0,
        operationName: CTP_CONFIG.runtime.dataverseCustomApiName
      });
      const response = await xrm.WebApi.online.execute(apiRequest);
      if (!response.ok) throw new Error("Dataverse Custom API failed with status " + response.status);
      const json = await response.json();
      const raw = json[out] || json.ctp_responsejson || json.response;
      return typeof raw === "string" ? JSON.parse(raw) : (raw || json);
    }

    function openStaging() {
      const id = state.response?.result?.vendorQuoteStagingId;
      const xrm = getXrm();
      if (!id) return showToast("No staging record ID was returned yet.");
      if (xrm?.Navigation?.openForm) {
        xrm.Navigation.openForm({ entityName: CTP_CONFIG.dataverse.stagingEntityLogicalName, entityId: id });
      } else showToast("Open this inside Dynamics 365 to navigate to the staging record.");
    }

    function copyPayload() {
      const payload = state.response?.payload;
      if (!payload) return showToast("No payload to copy yet.");
      navigator.clipboard?.writeText(pretty(payload)).then(() => showToast("Payload copied."), () => showToast("Could not copy payload."));
    }



    function markLineChangesDirty() {
      state.unsavedLineChanges = true;
      state.approved = false;
      const msg = byId("lineDirtyMessage");
      if (msg) msg.classList.add("show");
      const save = byId("saveLineEdits");
      if (save) save.disabled = false;
      const approved = byId("approved");
      if (approved) {
        approved.checked = false;
        approved.disabled = true;
      }
      const approveCreate = byId("approveCreate");
      if (approveCreate) approveCreate.disabled = true;
    }

    function saveLineEdits() {
      if (!state.response?.payload?.lines) return showToast("No line items to save.");
      const updated = state.response.payload.lines.map((line, index) => {
        const get = (field) => document.querySelector(`[data-line-index="${index}"][data-field="${field}"]`);
        const approvedEl = get("userApproved");
        const useWriteInEl = get("useWriteInProduct");
        const vendorSku = get("vendorSku")?.value?.trim() || null;
        const productName = get("productName")?.value?.trim() || "";
        const description = get("description")?.value?.trim() || productName;
        const quantity = toNumberOrZero(get("quantity")?.value);
        const unitOfMeasure = get("unitOfMeasure")?.value?.trim() || "Each";
        const vendorUnitCost = toNumberOrNull(get("vendorUnitCost")?.value);
        const vendorExtendedCost = vendorUnitCost == null ? null : Number((vendorUnitCost * quantity).toFixed(2));
        const matchStatus = get("matchStatus")?.value || line.matchStatus || "Unmatched";
        const userApproved = !!approvedEl?.checked;
        const useWriteInProduct = !!useWriteInEl?.checked;

        const changed = vendorSku !== (line.vendorSku ?? null)
          || productName !== (line.productName ?? "")
          || description !== (line.description ?? "")
          || quantity !== Number(line.quantity ?? 0)
          || unitOfMeasure !== (line.unitOfMeasure ?? "Each")
          || vendorUnitCost !== (line.vendorUnitCost ?? null)
          || matchStatus !== (line.matchStatus ?? "Unmatched")
          || useWriteInProduct !== !!line.useWriteInProduct
          || userApproved !== !!line.userApproved;

        return {
          ...line,
          vendorSku,
          productName,
          description,
          quantity,
          unitOfMeasure,
          vendorUnitCost,
          vendorExtendedCost,
          matchStatus,
          useWriteInProduct,
          userApproved,
          reviewDecision: userApproved ? "Approved" : "Pending Review",
          userModified: changed || !!line.userModified,
          lastEditedOnUtc: changed ? new Date().toISOString() : line.lastEditedOnUtc
        };
      });

      state.response.payload.lines = updated;
      state.response.payload.review = {
        approvedLineCount: updated.filter(l => !!l.userApproved).length,
        totalLineCount: updated.length,
        allLinesApproved: updated.length > 0 && updated.every(l => !!l.userApproved),
        savedOnUtc: new Date().toISOString()
      };
      state.unsavedLineChanges = false;
      state.approved = false;
      state.progressStage = allLinesApproved() ? "review" : "review";
      state.progressText = allLinesApproved()
        ? "All line edits were saved. Confirm final quote approval to create Opportunity Product Lines."
        : "Line edits were saved. Approve each line before final creation.";
      render();
      showToast("Line changes saved into the payload.");
    }

    function approveAllLines() {
      if (!state.response?.payload?.lines?.length) return showToast("No line items to approve.");
      state.response.payload.lines = state.response.payload.lines.map(line => ({
        ...line,
        userApproved: true,
        reviewDecision: "Approved",
        reviewedOnUtc: new Date().toISOString()
      }));
      state.response.payload.review = {
        approvedLineCount: state.response.payload.lines.length,
        totalLineCount: state.response.payload.lines.length,
        allLinesApproved: true,
        savedOnUtc: new Date().toISOString()
      };
      state.unsavedLineChanges = false;
      state.approved = false;
      state.progressStage = "review";
      state.progressText = "All lines are approved. Confirm final quote approval to create Opportunity Product Lines.";
      render();
      showToast("All line items approved in the payload.");
    }

    function clearLineApprovals() {
      if (!state.response?.payload?.lines?.length) return showToast("No line items to update.");
      state.response.payload.lines = state.response.payload.lines.map(line => ({
        ...line,
        userApproved: false,
        reviewDecision: "Pending Review",
        reviewedOnUtc: null
      }));
      state.response.payload.review = {
        approvedLineCount: 0,
        totalLineCount: state.response.payload.lines.length,
        allLinesApproved: false,
        savedOnUtc: new Date().toISOString()
      };
      state.unsavedLineChanges = false;
      state.approved = false;
      state.progressStage = "review";
      state.progressText = "Line approvals were cleared. Review and approve each line before final creation.";
      render();
      showToast("Line approvals cleared.");
    }

