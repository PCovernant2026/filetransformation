function addHoverTextToField(fieldName, text) {
    if ($("#" + fieldName) != null && $("#" + fieldName).parent() != null && $("#" + fieldName).parent().parent() != null && $("#" + fieldName).parent().parent().parent()) {
        $("#" + fieldName).parent().parent().parent().hover(function () {
            $(this).css('cursor', 'pointer').attr('title', text);
        }, function () {
            $(this).css('cursor', 'auto');
        });
    }
}

function handleRowAdded(mutations) {
    mutations.forEach(mutation => {
        if (mutation.type === 'childList') {
            gridOnChange();
        }
    });
}


