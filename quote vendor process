          <td class="qty-cell"><input class="cell-input" type="number" step="0.01" min="0" data-edit="line" data-line-index="${index}" data-field="quantity" value="${esc(l.quantity ?? "")}" /></td>
          <td class="uom-cell"><input class="cell-input" data-edit="line" data-line-index="${index}" data-field="unitOfMeasure" value="${esc(l.unitOfMeasure || "Each")}" /></td>
          <td class="cost-cell"><input class="cell-input" type="number" step="0.01" min="0" data-edit="line" data-line-index="${index}" data-field="vendorUnitCost" value="${l.vendorUnitCost == null ? "" : esc(l.vendorUnitCost)}" placeholder="Missing" /></td>
          <td class="status-cell">
            <select class="cell-select" data-edit="line" data-line-index="${index}" data-field="matchStatus">
              ${["Matched", "Unmatched", "Low Confidence", "Write-In", "Skipped"].map(s => `<option value="${esc(s)}" ${String(l.matchStatus || "").toLowerCase() === s.toLowerCase() ? "selected" : ""}>${esc(s)}</option>`).join("")}
            </select>
            <label class="small" style="display:flex;align-items:center;gap:6px;margin-top:7px;">
              <input type="checkbox" data-edit="line" data-line-index="${index}" data-field="useWriteInProduct" ${l.useWriteInProduct ? "checked" : ""} /> Write-in
            </label>
          </td>
          <td class="reason-cell"><div class="small" title="${esc(l.reason || "")}">${esc(l.reason || "")}</div>${l.matchConfidence != null ? `<div class="small">Confidence: ${esc(l.matchConfidence)}</div>` : ""}</td>
        </tr>
      `).join("");

      return `
        <div class="table-actionbar">
          <div class="review-summary">
            <span class="review-pill ${allLinesApproved() ? "good" : "warn"}">${approved}/${total} lines approved</span>
            <span id="lineDirtyMessage" class="line-dirty-message ${state.unsavedLineChanges ? "show" : ""}">Unsaved line changes</span>
            <span>Edits saved here update the payload used by the agent to create records.</span>
          </div>
          <div class="actions">
            <button class="btn secondary" id="approveAllLines" ${state.busy ? "disabled" : ""}>Approve all lines</button>
            <button class="btn secondary" id="clearLineApprovals" ${state.busy ? "disabled" : ""}>Clear approvals</button>
            <button class="btn" id="saveLineEdits" ${state.busy || !state.unsavedLineChanges ? "disabled" : ""}>Save line changes</button>
          </div>
        </div>
        <div class="edit-note">Review each line, edit values as needed, approve the line, then save. The Payload JSON tab updates from these saved edits.</div>
        <div class="table-wrap"><table class="editable-table">
          <colgroup>
            <col class="col-approve" />
            <col class="col-line" />
            <col class="col-product" />
            <col class="col-description" />
            <col class="col-qty" />
            <col class="col-uom" />
            <col class="col-cost" />
            <col class="col-status" />
            <col class="col-reason" />
          </colgroup>
          <thead><tr><th>Approve</th><th>Line</th><th>Product / SKU</th><th>Description</th><th>Qty</th><th>UOM</th><th>Unit cost</th><th>Status</th><th>Agent reason</th></tr></thead><tbody>${rows}</tbody></table></div>`;
    }

    function renderHeader() {
      if (!state.response?.payload) return `<div class="panel-pad"><div class="alert info">No header payload yet.</div></div>`;
      const h = header();
      return `<div class="panel-pad"><div class="form-grid">
        ${readonly("Vendor", h.vendorName)}
        ${readonly("Quote number", h.quoteNumber)}
        ${readonly("File name", h.fileName)}
        ${readonly("File reference", h.fileUrl)}
        ${readonly("Currency", h.currency)}
        ${readonly("Confidence", h.confidence)}
      </div></div>`;
    }

    function readonly(label, value) {
      return `<div class="field"><label>${esc(label)}</label><input class="input" value="${esc(value ?? "N/A")}" readonly /></div>`;
    }

    function renderPayload() {
      if (!state.response?.payload) return `<div class="panel-pad"><div class="alert info">No payload yet.</div></div>`;
      return `<div class="panel-pad"><div class="code">${esc(pretty(state.response.payload))}</div></div>`;
    }

    function renderResult() {
      if (!state.response) return `<div class="panel-pad"><div class="alert info">No result yet.</div></div>`;
      return `<div class="panel-pad"><div class="alert ${state.response.success ? "success" : "danger"}"><strong>${esc(state.response.status || "Result")}</strong><br>${esc(state.response.message || "")}</div><div class="code" style="margin-top:12px">${esc(pretty(state.response.result || state.response))}</div></div>`;
    }

    function wire() {
      byId("fileInput")?.addEventListener("change", onFileChange);
      byId("browseFile")?.addEventListener("click", e => { e.stopPropagation(); byId("fileInput")?.click(); });
      const dropzone = byId("dropzone");
      if (dropzone) {
        dropzone.addEventListener("click", onDropZoneClick);
        dropzone.addEventListener("keydown", onDropZoneKeydown);
        dropzone.addEventListener("dragover", onDropZoneDragOver);
        dropzone.addEventListener("dragenter", onDropZoneDragOver);
        dropzone.addEventListener("dragleave", onDropZoneDragLeave);
        dropzone.addEventListener("drop", onDropZoneDrop);
      }
      byId("fileRef")?.addEventListener("input", e => state.fileReference = e.target.value);
      byId("vendorHint")?.addEventListener("input", e => state.vendorHint = e.target.value);
      byId("instruction")?.addEventListener("input", e => state.instruction = e.target.value);
      byId("askAgent")?.addEventListener("click", () => askAgent("extract_map_preview"));
      byId("refreshMapping")?.addEventListener("click", () => askAgent("refresh_mapping"));
      byId("copyPayload")?.addEventListener("click", copyPayload);
      byId("approved")?.addEventListener("change", e => { const checked = !!e.target.checked; setState({ approved: checked, progressStage: checked ? "approved" : "review", progressText: checked ? "Quote reviewed and approved. Ready to create Opportunity Product Lines." : "Review mapped quote lines before approval." }); });
      byId("approveCreate")?.addEventListener("click", () => askAgent("approve_create_products"));
      byId("openStaging")?.addEventListener("click", openStaging);
      byId("saveLineEdits")?.addEventListener("click", saveLineEdits);
      byId("approveAllLines")?.addEventListener("click", approveAllLines);
      byId("clearLineApprovals")?.addEventListener("click", clearLineApprovals);
      document.querySelectorAll("[data-edit='line']").forEach(el => {
        el.addEventListener("input", markLineChangesDirty);
        el.addEventListener("change", markLineChangesDirty);
      });
      document.querySelectorAll(".tab").forEach(t => t.addEventListener("click", () => setState({ activeTab: t.getAttribute("data-tab") || "lines" })));
    }

    document.addEventListener("DOMContentLoaded", render);
  </script>
</body>
</html>


