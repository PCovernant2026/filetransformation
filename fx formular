using Microsoft.Crm.Sdk.Messages;
using Microsoft.Xrm.Sdk;
using Microsoft.Xrm.Sdk.Query;
using Microsoft.Xrm.Sdk.Workflow;
using System;
using System.Activities;
using System.Collections.Generic;
using System.Linq;
using System.Text;
using System.Threading.Tasks;

namespace CTP.WorkflowAssembly
{
    public class OpportunityLost : CodeActivity
    {
        protected override void Execute(CodeActivityContext context)
        {
            try
            {
                IWorkflowContext executionContext = context.GetExtension<IWorkflowContext>();
                IOrganizationServiceFactory serviceFactory = context.GetExtension<IOrganizationServiceFactory>();
                IOrganizationService service = serviceFactory.CreateOrganizationService(executionContext.InitiatingUserId);

                Entity opportunity = service.Retrieve(executionContext.PrimaryEntityName, executionContext.PrimaryEntityId, new ColumnSet(false));
                //int lostStatusReason = statusReasonValue.Get(context);
                #region Quote

                QueryExpression quoteQuery = new QueryExpression
                {
                    EntityName = "quote",
                    ColumnSet = new ColumnSet("quoteid", "statecode", "statuscode"),
                    Criteria = {Conditions =
                    {
                        new ConditionExpression("opportunityid", ConditionOperator.Equal, opportunity.Id)
                    }
                }
                };

                EntityCollection quotes = service.RetrieveMultiple(quoteQuery);
                //throw new Exception(quotes.Entities.Count().ToString());
                foreach (Entity entity in quotes.Entities)
                {
                    if (((OptionSetValue)entity.Attributes["statecode"]).Value != 0)
                    {
                        //Draft Quote
                        DraftQuote(entity, service);
                        
                    }
                    //Activate Quote
                    ActivateQuote(entity, service);
                }

                quotes = service.RetrieveMultiple(quoteQuery);
                foreach (Entity ent in quotes.Entities)
                {
                    Entity closeEntity = new Entity("quoteclose");
                    closeEntity.Attributes.Add("subject", "Closing Quote, Opportunity Closed" + DateTime.Now.ToString());
                    closeEntity.Attributes.Add("quoteid", ent.ToEntityReference());
                    CloseQuoteRequest closequote = new CloseQuoteRequest
                    {
                        QuoteClose = closeEntity,
                        Status = new OptionSetValue(6)//Cancelled
                    };

                    try
                    {
                        CloseQuoteResponse response = (CloseQuoteResponse)service.Execute(closequote);
                    }
                    catch (Exception ex)
                    {
                        throw new Exception("quote:" + ((OptionSetValue)ent.Attributes["statecode"]).Value.ToString() + ex.Message);
                    }

                }

                #endregion

                #region GlazingContractor
                //throw new Exception(opportunity.ToEntityReference().LogicalName.ToString());
                QueryExpression glazingContractorQuery = new QueryExpression
                {
                    EntityName = "new_glazingcontractor",
                    ColumnSet = new ColumnSet("statecode", "statuscode"),
                    Criteria = {Conditions =
                    {
                        new ConditionExpression("new_projectname", ConditionOperator.Equal, opportunity.Id)
                    }
                }
                };

                EntityCollection glazingContractors = service.RetrieveMultiple(glazingContractorQuery);
                foreach (Entity glazingContractor in glazingContractors.Entities)
                {
                    SetStateRequest request = new SetStateRequest
                    {
                        EntityMoniker = glazingContractor.ToEntityReference(),
                        State = new OptionSetValue(1),//Inactive
                        Status = new OptionSetValue(2)//Lost
                    };
                    try
                    {
                        service.Execute(request);
                    }
                    catch (Exception ex)
                    {
                        throw ex.InnerException;
                        //If for some reason one of the other Glazing Contractor Quotes cannot be closed, we just move on.
                    }
                }

                
                #endregion

               /* #region Opportunity

                Entity lostOpportunity = new Entity("opportunityclose");
                lostOpportunity.Attributes.Add("subject", "Opportunity Close" + DateTime.Now.ToString());
                lostOpportunity.Attributes.Add("opportunityid", opportunity.ToEntityReference());

                LoseOpportunityRequest oppRequest = new LoseOpportunityRequest
                {
                    OpportunityClose = lostOpportunity,
                    Status = new OptionSetValue(lostStatusReason)
                };

                try
                {
                    LoseOpportunityResponse response = (LoseOpportunityResponse)service.Execute(oppRequest);
                }
                catch(Exception ex)
                {
                    throw new Exception("Opp:"+ ex.Message);
                }
                #endregion*/

            }
            catch (Exception ex)
            {
                throw ex;
            }
        }

        private void ActivateQuote(Entity entity, IOrganizationService userService)
        {
            SetStateRequest activateQuote = new SetStateRequest()
            {
                EntityMoniker = entity.ToEntityReference(),
                State = new OptionSetValue(1),//Active
                Status = new OptionSetValue(3)//Open
            };

            try
            {
                userService.Execute(activateQuote);
            }
            catch (Exception ex)
            {
                throw new Exception("Activate" + ex.Message);
            }
        }

        private void DraftQuote(Entity entity, IOrganizationService userService)
        {
            SetStateRequest draftQuote = new SetStateRequest()
            {
                EntityMoniker = entity.ToEntityReference(),
                State = new OptionSetValue(0),//Draft
                Status = new OptionSetValue(1)//InProgress
            };

            try
            {
                userService.Execute(draftQuote);
            }
            catch (Exception ex)
            {
                throw new Exception("Draft" + ex.Message);
                //If for some reason one of the other Glazing Contractor Quotes cannot be closed, we just move on.
            }
        }
    }
}
