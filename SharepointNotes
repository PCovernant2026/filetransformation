            {
                return;
            }

            Trace(
                tracingService,
                "========== {0} SharepointOpportunityAttachmentSync CONTEXT ==========",
                marker);
            Trace(tracingService, "CorrelationId={0}", context.CorrelationId);
            Trace(tracingService, "OperationId={0}", context.OperationId);
            Trace(tracingService, "RequestId={0}", context.RequestId);
            Trace(tracingService, "OrganizationId={0}", context.OrganizationId);
            Trace(tracingService, "OrganizationName={0}", context.OrganizationName);
            Trace(tracingService, "MessageName={0}", context.MessageName);
            Trace(tracingService, "PrimaryEntityName={0}", context.PrimaryEntityName);
            Trace(tracingService, "PrimaryEntityId={0}", context.PrimaryEntityId);
            Trace(tracingService, "Stage={0}", context.Stage);
            Trace(tracingService, "Mode={0}", context.Mode);
            Trace(tracingService, "Depth={0}", context.Depth);
            Trace(tracingService, "UserId={0}", context.UserId);
            Trace(tracingService, "InitiatingUserId={0}", context.InitiatingUserId);
            Trace(tracingService, "BusinessUnitId={0}", context.BusinessUnitId);
            Trace(tracingService, "OwningExtensionId={0}", context.OwningExtension?.Id);
            Trace(
                tracingService,
