function requiredFieldValidator(){
    var newValidator = document.createElement('span');
	newValidator.style.display = "none";
	newValidator.id = "crb5d_revisedquoteneededbyValidator";
	newValidator.controltovalidate = "crb5d_revisedquoteneededby";
	newValidator.errormessage = "Revised Quote Needed By is a required field when Revision Needs contains data";

	newValidator.evaluationfunction = function () {
		if ($('#crb5d_revisionneeds').val().trim().length > 0 && $('#crb5d_revisedquoteneededby_datepicker_description').val().trim().length < 1) {
			return false
		} else {
			return true;
		}
	};

	// Add the new validator to the page validators array:
	Page_Validators.push(newValidator);
}

function addeWindowsSeriesListener() {
    if ($("#WindowSeries")[0].children[0].querySelector('.view-grid') !== null) {
        if ($("#WindowSeries")[0].children[0].querySelector('.view-grid').querySelector("table") === null) {
            setTimeout(addeWindowsSeriesListener, 2000);
        }
        else {
            let observer = new MutationObserver(handleRowAdded);
            gridOnChange();

            // Start observing the table body for child list changes
            observer.observe($("#WindowSeries")[0].children[0].querySelector('.view-grid').querySelector("table"), { childList: true }); 
        }
    }
}

