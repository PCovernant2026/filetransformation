using Microsoft.Xrm.Sdk;
using Microsoft.Xrm.Sdk.Query;
using System;
using System.Linq;
using System.ServiceModel;
using System.Text.RegularExpressions;

namespace Winco.Dynamics365.Plugins
{
    /// <summary>
    /// ActivityMimeAttachmentToSharePointSyncTrackerPlugin
    ///
    /// Purpose:
    /// When an Email attachment (activitymimeattachment) is created and the parent Email is
    /// regarding an Opportunity, create a tracking row (ctp_notesharepointsync) with Pending status.
    ///
    /// Enhancements in this version:
    /// - Generates ctp_targetfoldername using the same approach as the annotation plugin:
    ///   "<SanitizedOppName>_<OpportunityGuid>"
    /// - Stores polymorphic source record id in ctp_annotationid (per your current design)
    /// - Stores source table discriminator in ctp_sourcetable
    ///
    /// Register:
    /// - Message: Create
    /// - Primary Entity: activitymimeattachment
    /// - Stage: PostOperation
    /// - Mode: Asynchronous (recommended)
    /// </summary>
    public sealed class ActivityMimeAttachmentToSharePointSyncTrackerPlugin : IPlugin
    {
        public void Execute(IServiceProvider serviceProvider)
        {
            var tracing = (ITracingService)serviceProvider.GetService(typeof(ITracingService));
            var context = (IPluginExecutionContext)serviceProvider.GetService(typeof(IPluginExecutionContext));
            var factory = (IOrganizationServiceFactory)serviceProvider.GetService(typeof(IOrganizationServiceFactory));
            var service = factory.CreateOrganizationService(context.UserId);

            TraceContext(tracing, context, "START");

            try
            {
                if (context == null)
                    throw new InvalidPluginExecutionException("Plugin execution context is null.");

                if (!string.Equals(context.MessageName, "Create", StringComparison.OrdinalIgnoreCase))
                {
                    tracing.Trace("EXIT: MessageName is not Create.");
                    return;
                }

                if (!string.Equals(context.PrimaryEntityName, Entities.ActivityMimeAttachment, StringComparison.OrdinalIgnoreCase))
                {
                    tracing.Trace("EXIT: PrimaryEntityName is not activitymimeattachment.");
                    return;
                }

                if (!context.InputParameters.Contains("Target") || !(context.InputParameters["Target"] is Entity target))
                {
                    tracing.Trace("EXIT: Target missing or not an Entity.");
                    return;
                }

                if (target.Id == Guid.Empty)
                {
                    tracing.Trace("EXIT: Target Id is empty.");
                    return;
                }

                tracing.Trace("Target entity: {0}, Id: {1}", target.LogicalName, target.Id);

                // Retrieve attachment metadata (do not retrieve body here; flow will do it)
                var attachment = service.Retrieve(
                    Entities.ActivityMimeAttachment,
                    target.Id,
                    new ColumnSet(
                        AmaFields.ActivityId,
                        AmaFields.FileName,
                        AmaFields.MimeType,
                        AmaFields.Subject
                    ));

                var fileName = attachment.GetAttributeValue<string>(AmaFields.FileName) ?? string.Empty;
                var mimeType = attachment.GetAttributeValue<string>(AmaFields.MimeType) ?? string.Empty;
                var attachmentSubject = attachment.GetAttributeValue<string>(AmaFields.Subject) ?? string.Empty;
                var activityRef = attachment.GetAttributeValue<EntityReference>(AmaFields.ActivityId);

                tracing.Trace("Attachment metadata:");
                tracing.Trace(" - filename: {0}", string.IsNullOrWhiteSpace(fileName) ? "(empty)" : fileName);
                tracing.Trace(" - mimetype: {0}", string.IsNullOrWhiteSpace(mimeType) ? "(empty)" : mimeType);
                tracing.Trace(" - subject: {0}", string.IsNullOrWhiteSpace(attachmentSubject) ? "(empty)" : attachmentSubject);
                tracing.Trace(" - activityid present: {0}", activityRef != null);

                if (activityRef == null || activityRef.Id == Guid.Empty)
                {
                    tracing.Trace("SKIP: activityid is null/empty; cannot resolve parent email.");
                    return;
                }

                // activityid targets activitypointer; for email attachments, it points to the email activity id.
                var emailId = activityRef.Id;

                // Retrieve parent Email and check Regarding = Opportunity
                Entity email;
                try
                {
                    email = service.Retrieve(
                        Entities.Email,
                        emailId,
                        new ColumnSet(EmailFields.RegardingObjectId, EmailFields.Subject));
                }
                catch (Exception ex)
                {
                    tracing.Trace("SKIP: Unable to retrieve Email {0}. Error: {1}", emailId, ex.Message);
                    return;
                }

                var emailSubject = email.GetAttributeValue<string>(EmailFields.Subject) ?? string.Empty;
                var regarding = email.GetAttributeValue<EntityReference>(EmailFields.RegardingObjectId);

                tracing.Trace("Email metadata:");
                tracing.Trace(" - emailid: {0}", emailId);
                tracing.Trace(" - email subject: {0}", string.IsNullOrWhiteSpace(emailSubject) ? "(empty)" : emailSubject);
                tracing.Trace(" - regarding present: {0}", regarding != null);
                tracing.Trace(" - regarding logicalname: {0}", regarding?.LogicalName ?? "(null)");
                tracing.Trace(" - regarding id: {0}", regarding?.Id.ToString() ?? "(null)");

                if (regarding == null ||
                    !string.Equals(regarding.LogicalName, Entities.Opportunity, StringComparison.OrdinalIgnoreCase))
                {
                    tracing.Trace("SKIP: Parent email is not regarding an Opportunity.");
                    return;
                }

                // Duplicate check: one tracking row per source attachment record
                // NOTE: Your design stores the source record id into ctp_annotationid, so we check duplicates on that.
                if (TrackingRowExists(service, tracing, SourceTableChoices.ActivityMimeAttachment, target.Id.ToString("D")))
                {
                    tracing.Trace("EXIT: Tracking row already exists for activitymimeattachment {0}.", target.Id);
                    return;
                }

                // Retrieve Opportunity Name (needed to build target folder name)
                Entity opportunity = service.Retrieve(
                    Entities.Opportunity,
                    regarding.Id,
                    new ColumnSet(OpportunityFields.Name));

                var opportunityName = opportunity.GetAttributeValue<string>(OpportunityFields.Name) ?? "Opportunity";
                var folderName = SharePointNameHelper.BuildOpportunityFolderName(opportunityName, regarding.Id);

                tracing.Trace("Folder name generation:");
                tracing.Trace(" - Opportunity Name: {0}", opportunityName);
                tracing.Trace(" - Target Folder Name: {0}", folderName);

                // Build tracking row
                var tracking = new Entity(Entities.Tracking);

                tracking[TrackingFields.Name] = BuildTrackingName(fileName, emailSubject, target.Id);
                tracking[TrackingFields.OpportunityId] = new EntityReference(Entities.Opportunity, regarding.Id);
                tracking[TrackingFields.DocName] = string.IsNullOrWhiteSpace(fileName) ? "Attachment" : fileName;
                tracking[TrackingFields.SyncStatus] = new OptionSetValue(TrackingStatus.Pending);

                // Discriminator + polymorphic source id (your chosen approach)
                tracking[TrackingFields.SourceTableChoices] = new OptionSetValue(SourceTableChoices.ActivityMimeAttachment);

                // IMPORTANT: You are using ctp_annotationid as the source-record-id field for BOTH record types.
                tracking[TrackingFields.SourceId] = target.Id.ToString("D");

                // This is the missing piece that caused Create_new_folder to fail with path=null
                tracking[TrackingFields.TargetFolderName] = folderName;

                // Clear result fields (flow will set these)
                tracking[TrackingFields.SharePointError] = null;
                tracking[TrackingFields.SharePointFileUrl] = null;

                var trackingId = service.Create(tracking);
                tracing.Trace("SUCCESS: Created tracking row {0} for activitymimeattachment {1}.", trackingId, target.Id);

                TraceContext(tracing, context, "END");
            }
            catch (FaultException<OrganizationServiceFault> ex)
            {
                tracing.Trace("OrganizationServiceFault: {0}", ex.ToString());
                throw;
            }
            catch (InvalidPluginExecutionException)
            {
                throw;
            }
            catch (Exception ex)
            {
                tracing.Trace("Unhandled exception: {0}", ex.ToString());
                throw new InvalidPluginExecutionException(
                    "An error occurred in ActivityMimeAttachmentToSharePointSyncTrackerPlugin.", ex);
            }
        }

        private static bool TrackingRowExists(IOrganizationService service, ITracingService tracing, int sourceChoiceValue, string sourceId)
        {
            var q = new QueryExpression(Entities.Tracking)
            {
                ColumnSet = new ColumnSet(TrackingFields.Name),
                TopCount = 1
            };

            q.Criteria.AddCondition(TrackingFields.SourceTableChoices, ConditionOperator.Equal, sourceChoiceValue);
            q.Criteria.AddCondition(TrackingFields.SourceId, ConditionOperator.Equal, sourceId);

            var existing = service.RetrieveMultiple(q);
            tracing.Trace("Duplicate check: {0} rows found for sourceChoice={1}, sourceId={2}",
                existing.Entities.Count, sourceChoiceValue, sourceId);

            return existing.Entities.Count > 0;
        }

        private static string BuildTrackingName(string fileName, string emailSubject, Guid fallbackId)
        {
            var safeFile = string.IsNullOrWhiteSpace(fileName) ? "Attachment" : fileName.Trim();
            var safeSubject = string.IsNullOrWhiteSpace(emailSubject) ? "Email" : emailSubject.Trim();
            var combined = $"{safeFile} - {safeSubject}";

            const int max = 180;
            if (combined.Length > max) combined = combined.Substring(0, max).Trim();
            if (string.IsNullOrWhiteSpace(combined)) combined = fallbackId.ToString("D");

            return combined;
        }

        private static void TraceContext(ITracingService tracing, IPluginExecutionContext context, string marker)
        {
            if (tracing == null || context == null) return;

            tracing.Trace("========== {0} ActivityMimeAttachmentToSharePointSyncTrackerPlugin ==========", marker);
            tracing.Trace("CorrelationId: {0}", context.CorrelationId);
            tracing.Trace("OperationId: {0}", context.OperationId);
            tracing.Trace("MessageName: {0}", context.MessageName);
            tracing.Trace("PrimaryEntityName: {0}", context.PrimaryEntityName);
            tracing.Trace("PrimaryEntityId: {0}", context.PrimaryEntityId);
            tracing.Trace("Stage: {0}", context.Stage);
            tracing.Trace("Mode: {0}", context.Mode);
            tracing.Trace("Depth: {0}", context.Depth);
            tracing.Trace("UserId: {0}", context.UserId);
            tracing.Trace("===============================================================");
        }

        private static class Entities
        {
            public const string ActivityMimeAttachment = "activitymimeattachment";
            public const string Email = "email";
            public const string Opportunity = "opportunity";
            public const string Tracking = "ctp_notesharepointsync";
        }

        private static class AmaFields
        {
            public const string ActivityId = "activityid"; // lookup to activitypointer
            public const string FileName = "filename";
            public const string MimeType = "mimetype";
            public const string Subject = "subject";
        }

        private static class EmailFields
        {
            public const string RegardingObjectId = "regardingobjectid";
            public const string Subject = "subject";
        }

        private static class OpportunityFields
        {
            public const string Name = "name";
        }

        private static class TrackingFields
        {
            public const string Name = "ctp_name";
            public const string OpportunityId = "ctp_opportunityid";
            public const string DocName = "ctp_docname";
            public const string SyncStatus = "ctp_spsyncstatus";
            public const string TargetFolderName = "ctp_targetfoldername";
            public const string SharePointError = "ctp_sharepointerror";
            public const string SharePointFileUrl = "ctp_sharepointfileurl";

            // Your discriminator + polymorphic source id
            public const string SourceTableChoices = "ctp_sourcetable"; // choice
            public const string SourceId = "ctp_annotationid";          // string (stores source record id)
        }

        private static class TrackingStatus
        {
            public const int Pending = 961490000;
            public const int InProgress = 961490001;
            public const int Succeeded = 961490002;
            public const int Failed = 961490003;
            public const int Skipped = 961490004;
        }

        private static class SourceTableChoices
        {
            public const int Annotation = 961490000;
            public const int ActivityMimeAttachment = 961490001;
        }

        /// <summary>
        /// Same helper logic as your Annotation plugin to create SharePoint-safe folder names.
        /// </summary>
        private static class SharePointNameHelper
        {
            public static string BuildOpportunityFolderName(string opportunityName, Guid opportunityId)
            {
                string cleanName = SanitizeForSharePoint(opportunityName);
                return $"{cleanName}_{opportunityId:D}";
            }

            public static string SanitizeForSharePoint(string input)
            {
                if (string.IsNullOrWhiteSpace(input))
                {
                    return "Opportunity";
                }

                // Remove invalid SharePoint folder characters:
                // / \ : * ? " < > | # %
                string cleaned = Regex.Replace(input, @"[/\\:\*\?""<>|#%]", string.Empty);

                // Remove control chars
                cleaned = new string(cleaned.Where(c => !char.IsControl(c)).ToArray());

                // Collapse whitespace
                cleaned = Regex.Replace(cleaned, @"\s+", " ").Trim();

                // SharePoint doesn't like trailing dots/spaces
                cleaned = cleaned.Trim().TrimEnd('.');

                const int maxLength = 120;
                if (cleaned.Length > maxLength)
                {
                    cleaned = cleaned.Substring(0, maxLength).Trim().TrimEnd('.');
                }

                if (string.IsNullOrWhiteSpace(cleaned))
                {
                    return "Opportunity";
                }

                return cleaned;
            }
        }
    }
}
