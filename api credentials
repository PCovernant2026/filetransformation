using Microsoft.Xrm.Sdk;
using System;

namespace CTP.VendorQuoteAgent
{
    public class InvokeVendorQuoteAgentPlugin : IPlugin
    {
        public void Execute(IServiceProvider serviceProvider)
        {
            var context = (IPluginExecutionContext)serviceProvider.GetService(typeof(IPluginExecutionContext));
            var tracing = (ITracingService)serviceProvider.GetService(typeof(ITracingService));

            string requestJson = string.Empty;

            if (context.InputParameters.Contains("ctp_RequestJson") &&
                context.InputParameters["ctp_RequestJson"] != null)
            {
                requestJson = context.InputParameters["ctp_RequestJson"].ToString();
            }

            tracing.Trace("ctp_InvokeVendorQuoteAgent called.");
            tracing.Trace("Request JSON: " + requestJson);

            string responseJson = @"{
                ""success"": true,
                ""operation"": ""test_connection"",
                ""status"": ""Bridge Connected"",
                ""message"": ""Embedded Portal reached Dataverse Custom API successfully."",
                ""payload"": {
                    ""header"": {
                        ""vendorName"": ""Test Vendor"",
                        ""quoteNumber"": ""TEST-001""
                    },
                    ""lines"": []
                }
            }";

            context.OutputParameters["ctp_ResponseJson"] = responseJson;
        }
    }
}
