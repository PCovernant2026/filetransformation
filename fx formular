using System;
using System.Collections.Generic;
using Microsoft.Xrm.Sdk;
using Microsoft.Xrm.Sdk.Query;

namespace VGS.Dynamics365.Plugins
{
    /// <summary>
    /// Creates vgsd_holecalculations records when a vgsd_holedetails record is created.
    ///
    /// Registration:
    /// - Message: Create
    /// - Primary Entity: vgsd_holedetails
    /// - Stage: PostOperation
    /// - Mode: Synchronous recommended
    ///
    /// Logic:
    /// - If the related Work Order Primary Incident Type is Concrete:
    ///     Create 2 Hole Calculation records:
    ///       1. Structural product: productnumber 000002
    ///       2. Finish product: productnumber 000001
    ///
    /// - If the related Work Order Primary Incident Type is not Concrete:
    ///     Create 1 Hole Calculation record with no product.
    ///
    /// - Prevents duplicate Hole Calculation creation for the same Hole Detail.
    /// - Runs as SYSTEM.
    ///
    /// Recommended Unsecure Configuration:
    /// ConcreteIncidentTypeId=PUT-CONCRETE-INCIDENT-TYPE-GUID-HERE
    /// </summary>
    public class CreateHoleCalculationsOnHoleDetailCreate : IPlugin
    {
        private const string HoleDetailsEntityName = "vgsd_holedetails";
        private const string HoleCalculationsEntityName = "vgsd_holecalculations";
        private const string ProductEntityName = "product";
        private const string WorkOrderEntityName = "msdyn_workorder";

        private const string HoleDetailLookupField = "vgsd_holedetail";
        private const string WorkOrderField = "vgsd_workorderid";
        private const string ProductLookupField = "vgsd_product";
        private const string NameField = "vgsd_name";

        private const string IncidentTypeField = "msdyn_primaryincidenttype";

        private const string ProductNumberField = "productnumber";
        private const string ProductNameField = "name";

        private const string StructuralProductNumber = "000002";
        private const string FinishProductNumber = "000001";

        private const string StateCodeField = "statecode";
        private const int ActiveStateCode = 0;

        private const int PostOperationStage = 40;

        private readonly Guid _concreteIncidentTypeId;
        private readonly string _concreteIncidentTypeName;

        public CreateHoleCalculationsOnHoleDetailCreate(string unsecureConfig, string secureConfig)
        {
            _concreteIncidentTypeName = "Concrete";

            var cfg = ParseConfig(unsecureConfig);

            if (cfg.TryGetValue("ConcreteIncidentTypeId", out string concreteIdStr) &&
                Guid.TryParse(concreteIdStr, out Guid concreteGuid))
            {
                _concreteIncidentTypeId = concreteGuid;
            }

            if (cfg.TryGetValue("ConcreteIncidentTypeName", out string incidentTypeName) &&
                !string.IsNullOrWhiteSpace(incidentTypeName))
            {
                _concreteIncidentTypeName = incidentTypeName.Trim();
            }
        }

        public CreateHoleCalculationsOnHoleDetailCreate() : this(null, null)
        {
        }

        public void Execute(IServiceProvider serviceProvider)
        {
            if (serviceProvider == null)
            {
                throw new ArgumentNullException(nameof(serviceProvider));
            }

            var context = (IPluginExecutionContext)serviceProvider.GetService(typeof(IPluginExecutionContext));
            var tracing = (ITracingService)serviceProvider.GetService(typeof(ITracingService));
            var factory = (IOrganizationServiceFactory)serviceProvider.GetService(typeof(IOrganizationServiceFactory));

            if (context == null)
            {
                throw new InvalidPluginExecutionException("Plugin execution context is null.");
            }

            if (factory == null)
            {
                throw new InvalidPluginExecutionException("Organization service factory is null.");
            }

            IOrganizationService service = factory.CreateOrganizationService(null);

            Trace(
                tracing,
                "CreateHoleCalculationsOnHoleDetailCreate started. Message={0}, PrimaryEntity={1}, Depth={2}, Mode={3}, Stage={4}",
                context.MessageName,
                context.PrimaryEntityName,
                context.Depth,
                context.Mode,
                context.Stage);

            try
            {
                if (!string.Equals(context.MessageName, "Create", StringComparison.OrdinalIgnoreCase))
                {
                    Trace(tracing, "Exiting: Message is not Create.");
                    return;
                }

                if (!string.Equals(context.PrimaryEntityName, HoleDetailsEntityName, StringComparison.OrdinalIgnoreCase))
                {
                    Trace(tracing, "Exiting: Primary entity is not {0}.", HoleDetailsEntityName);
                    return;
                }

                if (context.Stage != PostOperationStage)
                {
                    Trace(tracing, "Exiting: Plugin is not running in PostOperation. Current Stage={0}.", context.Stage);
                    return;
                }

                if (context.Depth > 1)
                {
                    Trace(tracing, "Exiting: Depth > 1 to prevent recursion. Depth={0}.", context.Depth);
                    return;
                }

                if (!context.InputParameters.Contains("Target") || !(context.InputParameters["Target"] is Entity))
                {
                    Trace(tracing, "Exiting: Target not found or invalid.");
                    return;
                }

                Entity target = (Entity)context.InputParameters["Target"];

                if (!string.Equals(target.LogicalName, HoleDetailsEntityName, StringComparison.OrdinalIgnoreCase))
                {
                    Trace(
                        tracing,
                        "Exiting: Target logical name {0} does not match expected {1}.",
                        target.LogicalName,
                        HoleDetailsEntityName);
                    return;
                }

                Guid holeDetailId = GetCreatedRecordId(context, target, tracing);

                if (holeDetailId == Guid.Empty)
                {
                    Trace(tracing, "Exiting: Could not determine created Hole Detail ID.");
                    return;
                }

                Trace(tracing, "Hole Detail ID resolved: {0}", holeDetailId);

                if (HoleCalculationsAlreadyExist(service, holeDetailId, tracing))
                {
                    Trace(
                        tracing,
                        "Exiting: Hole Calculation records already exist for Hole Detail {0}.",
                        holeDetailId);
                    return;
                }

                Entity holeDetail = RetrieveHoleDetailData(service, holeDetailId, target, tracing);

                EntityReference workOrderRef = holeDetail.GetAttributeValue<EntityReference>(WorkOrderField);

                if (workOrderRef != null)
                {
                    Trace(
                        tracing,
                        "Work Order found on Hole Detail. WorkOrderId={0}, WorkOrderName={1}",
                        workOrderRef.Id,
                        workOrderRef.Name ?? "null");
                }
                else
                {
                    Trace(tracing, "No Work Order found on Hole Detail.");
                }

                bool isConcrete = IsConcreteIncidentType(service, holeDetail, tracing);

                Trace(tracing, "Concrete evaluation result: isConcrete={0}", isConcrete);

                if (isConcrete)
                {
                    EntityReference structuralProductRef = GetProductReferenceByNumber(
                        service,
                        StructuralProductNumber,
                        tracing);

                    EntityReference finishProductRef = GetProductReferenceByNumber(
                        service,
                        FinishProductNumber,
                        tracing);

                    if (structuralProductRef == null)
                    {
                        throw new InvalidPluginExecutionException(
                            "Required active product was not found. Product Number = 000002 for Concrete - Structural.");
                    }

                    if (finishProductRef == null)
                    {
                        throw new InvalidPluginExecutionException(
                            "Required active product was not found. Product Number = 000001 for Concrete - Finish.");
                    }

                    CreateHoleCalculation(
                        service,
                        holeDetailId,
                        workOrderRef,
                        structuralProductRef,
                        "Hole Calculation - Structural",
                        tracing);

                    CreateHoleCalculation(
                        service,
                        holeDetailId,
                        workOrderRef,
                        finishProductRef,
                        "Hole Calculation - Finish",
                        tracing);
                }
                else
                {
                    CreateHoleCalculation(
                        service,
                        holeDetailId,
                        workOrderRef,
                        null,
                        "Hole Calculation",
                        tracing);
                }

                Trace(
                    tracing,
                    "CreateHoleCalculationsOnHoleDetailCreate completed successfully for Hole Detail {0}.",
                    holeDetailId);
            }
            catch (InvalidPluginExecutionException)
            {
                throw;
            }
            catch (Exception ex)
            {
                Trace(tracing, "CreateHoleCalculationsOnHoleDetailCreate error: {0}", ex.ToString());

                throw new InvalidPluginExecutionException(
                    "An error occurred while creating Hole Calculation records from the Hole Detail record. See plugin trace log for details.",
                    ex);
            }
        }

        private Entity RetrieveHoleDetailData(
            IOrganizationService service,
            Guid holeDetailId,
            Entity target,
            ITracingService tracing)
        {
            if (target.Attributes.Contains(WorkOrderField))
            {
                Trace(tracing, "Target already contains Work Order field. No retrieve needed.");
                return target;
            }

            Trace(
                tracing,
                "Target does not contain Work Order field. Retrieving Hole Detail {0} from Dataverse.",
                holeDetailId);

            Entity retrieved = service.Retrieve(
                HoleDetailsEntityName,
                holeDetailId,
                new ColumnSet(WorkOrderField));

            Entity merged = new Entity(HoleDetailsEntityName)
            {
                Id = holeDetailId
            };

            foreach (KeyValuePair<string, object> attribute in target.Attributes)
            {
                merged[attribute.Key] = attribute.Value;
            }

            foreach (KeyValuePair<string, object> attribute in retrieved.Attributes)
            {
                merged[attribute.Key] = attribute.Value;
            }

            return merged;
        }

        private bool IsConcreteIncidentType(
            IOrganizationService service,
            Entity holeDetail,
            ITracingService tracing)
        {
            EntityReference workOrderRef = holeDetail.GetAttributeValue<EntityReference>(WorkOrderField);

            if (workOrderRef == null)
            {
                Trace(tracing, "No Work Order found. Cannot evaluate Primary Incident Type.");
                return false;
            }

            Trace(
                tracing,
                "Retrieving Work Order {0} to read Primary Incident Type.",
                workOrderRef.Id);

            Entity workOrder = service.Retrieve(
                WorkOrderEntityName,
                workOrderRef.Id,
                new ColumnSet(IncidentTypeField));

            EntityReference incidentTypeRef = null;

            if (workOrder != null && workOrder.Attributes.Contains(IncidentTypeField))
            {
                incidentTypeRef = workOrder.GetAttributeValue<EntityReference>(IncidentTypeField);
            }

            if (incidentTypeRef == null)
            {
                Trace(
                    tracing,
                    "Work Order {0} does not have Primary Incident Type populated.",
                    workOrderRef.Id);
                return false;
            }

            Trace(
                tracing,
                "Primary Incident Type found. IncidentTypeId={0}, IncidentTypeName={1}, EntityName={2}",
                incidentTypeRef.Id,
                incidentTypeRef.Name ?? "null",
                incidentTypeRef.LogicalName ?? "null");

            if (_concreteIncidentTypeId != Guid.Empty)
            {
                bool matchById = incidentTypeRef.Id == _concreteIncidentTypeId;

                Trace(
                    tracing,
                    "Concrete Incident Type check by GUID. IncidentTypeId={0}, ConfigConcreteIncidentTypeId={1}, Match={2}",
                    incidentTypeRef.Id,
                    _concreteIncidentTypeId,
                    matchById);

                return matchById;
            }

            string incidentTypeName = incidentTypeRef.Name;

            if (string.IsNullOrWhiteSpace(incidentTypeName))
            {
                incidentTypeName = TryRetrieveIncidentTypeName(service, incidentTypeRef, tracing);
            }

            bool matchByName =
                !string.IsNullOrWhiteSpace(incidentTypeName) &&
                string.Equals(incidentTypeName, _concreteIncidentTypeName, StringComparison.OrdinalIgnoreCase);

            Trace(
                tracing,
                "Concrete Incident Type check by name. IncidentTypeName={0}, ExpectedName={1}, Match={2}",
                incidentTypeName ?? "null",
                _concreteIncidentTypeName,
                matchByName);

            return matchByName;
        }

        private string TryRetrieveIncidentTypeName(
            IOrganizationService service,
            EntityReference incidentTypeRef,
            ITracingService tracing)
        {
            if (incidentTypeRef == null || incidentTypeRef.Id == Guid.Empty)
            {
                return null;
            }

            if (string.IsNullOrWhiteSpace(incidentTypeRef.LogicalName))
            {
                Trace(tracing, "Cannot retrieve Incident Type name because LogicalName is empty.");
                return null;
            }

            try
            {
                Entity incidentType = service.Retrieve(
                    incidentTypeRef.LogicalName,
                    incidentTypeRef.Id,
                    new ColumnSet("msdyn_name"));

                string name = incidentType.GetAttributeValue<string>("msdyn_name");

                Trace(
                    tracing,
                    "Retrieved Incident Type name from msdyn_name. IncidentTypeId={0}, Name={1}",
                    incidentTypeRef.Id,
                    name ?? "null");

                return name;
            }
            catch (Exception ex)
            {
                Trace(
                    tracing,
                    "Unable to retrieve Incident Type name using msdyn_name. IncidentTypeId={0}, Error={1}",
                    incidentTypeRef.Id,
                    ex.Message);

                return null;
            }
        }

        private static Guid GetCreatedRecordId(
            IPluginExecutionContext context,
            Entity target,
            ITracingService tracing)
        {
            if (context.OutputParameters != null &&
                context.OutputParameters.Contains("id") &&
                context.OutputParameters["id"] is Guid)
            {
                Guid id = (Guid)context.OutputParameters["id"];

                Trace(tracing, "Record ID obtained from OutputParameters: {0}", id);

                return id;
            }

            if (target != null && target.Id != Guid.Empty)
            {
                Trace(tracing, "Record ID obtained from Target.Id: {0}", target.Id);

                return target.Id;
            }

            Trace(tracing, "Unable to determine created record ID.");

            return Guid.Empty;
        }

        private static bool HoleCalculationsAlreadyExist(
            IOrganizationService service,
            Guid holeDetailId,
            ITracingService tracing)
        {
            var query = new QueryExpression(HoleCalculationsEntityName)
            {
                ColumnSet = new ColumnSet(false),
                TopCount = 1
            };

            query.Criteria.AddCondition(
                HoleDetailLookupField,
                ConditionOperator.Equal,
                holeDetailId);

            EntityCollection results = service.RetrieveMultiple(query);

            bool exists = results != null && results.Entities.Count > 0;

            Trace(
                tracing,
                "Duplicate check for Hole Detail {0}: Existing Hole Calculations Found={1}",
                holeDetailId,
                exists);

            return exists;
        }

        private static EntityReference GetProductReferenceByNumber(
            IOrganizationService service,
            string productNumber,
            ITracingService tracing)
        {
            var query = new QueryExpression(ProductEntityName)
            {
                ColumnSet = new ColumnSet(ProductNameField, ProductNumberField),
                TopCount = 1
            };

            query.Criteria.AddCondition(
                ProductNumberField,
                ConditionOperator.Equal,
                productNumber);

            query.Criteria.AddCondition(
                StateCodeField,
                ConditionOperator.Equal,
                ActiveStateCode);

            EntityCollection results = service.RetrieveMultiple(query);

            if (results == null || results.Entities.Count == 0)
            {
                Trace(
                    tracing,
                    "No active product found with Product Number {0}.",
                    productNumber);

                return null;
            }

            Entity product = results.Entities[0];

            string productName = product.GetAttributeValue<string>(ProductNameField);

            Trace(
                tracing,
                "Product found. ProductNumber={0}, ProductName={1}, ProductId={2}",
                productNumber,
                productName ?? "null",
                product.Id);

            return new EntityReference(ProductEntityName, product.Id)
            {
                Name = productName
            };
        }

        private void CreateHoleCalculation(
            IOrganizationService service,
            Guid holeDetailId,
            EntityReference workOrderRef,
            EntityReference productRef,
            string recordName,
            ITracingService tracing)
        {
            var holeCalculation = new Entity(HoleCalculationsEntityName);

            holeCalculation[HoleDetailLookupField] = new EntityReference(
                HoleDetailsEntityName,
                holeDetailId);

            if (workOrderRef != null)
            {
                holeCalculation[WorkOrderField] = workOrderRef;
            }

            if (productRef != null)
            {
                holeCalculation[ProductLookupField] = productRef;
            }

            holeCalculation[NameField] = string.Format(
                "{0} - {1:D}",
                recordName,
                holeDetailId);

            Guid createdId = service.Create(holeCalculation);

            Trace(
                tracing,
                "Created Hole Calculation. Id={0}, HoleDetailId={1}, WorkOrderId={2}, ProductId={3}, ProductName={4}, Name={5}",
                createdId,
                holeDetailId,
                workOrderRef != null ? workOrderRef.Id.ToString() : "null",
                productRef != null ? productRef.Id.ToString() : "null",
                productRef != null ? productRef.Name ?? "null" : "null",
                holeCalculation.GetAttributeValue<string>(NameField));
        }

        private static Dictionary<string, string> ParseConfig(string config)
        {
            var dict = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);

            if (string.IsNullOrWhiteSpace(config))
            {
                return dict;
            }

            string[] parts = config.Split(
                new[] { ';' },
                StringSplitOptions.RemoveEmptyEntries);

            foreach (string part in parts)
            {
                string[] kv = part.Split(
                    new[] { '=' },
                    2,
                    StringSplitOptions.RemoveEmptyEntries);

                if (kv.Length == 2)
                {
                    dict[kv[0].Trim()] = kv[1].Trim();
                }
            }

            return dict;
        }

        private static void Trace(
            ITracingService tracing,
            string message,
            params object[] args)
        {
            if (tracing == null || string.IsNullOrWhiteSpace(message))
            {
                return;
            }

            if (args == null || args.Length == 0)
            {
                tracing.Trace(message);
            }
            else
            {
                tracing.Trace(message, args);
            }
        }
    }
}



using System;
using System.Collections.Generic;
using System.Linq;
using Microsoft.Xrm.Sdk;
using Microsoft.Xrm.Sdk.Query;

namespace VGS.Dynamics365.Plugins
{
    public sealed class RecalculateWorkOrderProductVolumePlugin : IPlugin
    {
        #region Logical Names

        private const string HoleCalculationEntityName = "vgsd_holecalculations";
        private const string HoleDetailEntityName = "vgsd_holedetails";
        private const string WorkOrderEntityName = "msdyn_workorder";
        private const string WorkOrderProductEntityName = "msdyn_workorderproduct";
        private const string ProductEntityName = "product";

        private const string HoleCalculationToHoleDetailField = "vgsd_holedetail";
        private const string HoleCalculationProductField = "vgsd_product";
        private const string HoleCalculationVolumeField = "vgsd_volumecubicft";

        private const string HoleDetailToWorkOrderField = "vgsd_workorderid";

        private const string WorkOrderProductToWorkOrderField = "msdyn_workorder";
        private const string WorkOrderProductToProductField = "msdyn_product";
        private const string WorkOrderProductQuantityField = "msdyn_quantity";
        private const string WorkOrderProductNameField = "msdyn_name";
        private const string WorkOrderProductLineStatusField = "msdyn_linestatus";

        private const string ProductNumberField = "productnumber";
        private const string ProductNameField = "name";

        private const string StateCodeField = "statecode";
        private const int ActiveStateCode = 0;

        private const int WorkOrderProductLineStatusEstimated = 690970000;
        private const int WorkOrderProductLineStatusUsed = 690970001;

        #endregion

        public void Execute(IServiceProvider serviceProvider)
        {
            if (serviceProvider == null)
                throw new ArgumentNullException(nameof(serviceProvider));

            var context = (IPluginExecutionContext)serviceProvider.GetService(typeof(IPluginExecutionContext));
            var tracing = (ITracingService)serviceProvider.GetService(typeof(ITracingService));
            var factory = (IOrganizationServiceFactory)serviceProvider.GetService(typeof(IOrganizationServiceFactory));

            // Run as SYSTEM to ensure the aggregation succeeds regardless of the
            // triggering user's privileges on product, holedetails, or workorderproduct.
            var service = factory.CreateOrganizationService(null);

            tracing.Trace(
                "RecalculateWorkOrderProductVolumePlugin started. Message={0}, Entity={1}, Stage={2}, Mode={3}, Depth={4}, CorrelationId={5}",
                context.MessageName,
                context.PrimaryEntityName,
                context.Stage,
                context.Mode,
                context.Depth,
                context.CorrelationId);

            try
            {
                if (!IsSupportedMessage(context.MessageName))
                {
                    tracing.Trace("Exit: unsupported message.");
                    return;
                }

                if (!string.Equals(context.PrimaryEntityName, HoleCalculationEntityName, StringComparison.OrdinalIgnoreCase))
                {
                    tracing.Trace("Exit: unsupported primary entity.");
                    return;
                }

                // Depth > 1 prevents re-entrancy. This plugin writes to msdyn_workorderproduct;
                // any downstream plugin that touches vgsd_holecalculations could loop otherwise.
                if (context.Depth > 1)
                {
                    tracing.Trace("Exit: depth > 1, skipping to prevent re-entrancy.");
                    return;
                }

                Entity targetEntity = null;

                if (context.InputParameters.Contains("Target"))
                    targetEntity = context.InputParameters["Target"] as Entity;

                Entity preImage = GetPreImage(context, "PreImage");
                Entity postImage = GetPostImage(context, "PostImage");

                if (postImage == null && (context.MessageName == "Create" || context.MessageName == "Update"))
                    tracing.Trace("WARNING: PostImage not registered. Falling back to live retrieve.");

                if (preImage == null && context.MessageName == "Update")
                    tracing.Trace("WARNING: PreImage not registered for Update. The previous product/work-order combination will NOT be recalculated if the product or hole detail changed.");

                var requests = new List<RecalcRequest>();

                switch (context.MessageName)
                {
                    case "Create":
                        {
                            Entity current = postImage ?? targetEntity;

                            if (current == null || current.Id == Guid.Empty || !HasMinimumHoleCalcFields(current))
                            {
                                Guid createdId = GetCreatedRecordId(context, targetEntity);
                                if (createdId != Guid.Empty)
                                    current = RetrieveHoleCalculation(service, createdId);
                            }

                            AddRecalcRequest(service, current, requests, tracing);
                            break;
                        }

                    case "Update":
                        {
                            Entity oldRow = preImage;
                            Entity newRow = postImage ?? targetEntity;

                            if (newRow != null && newRow.Id != Guid.Empty && !HasMinimumHoleCalcFields(newRow))
                                newRow = RetrieveHoleCalculation(service, newRow.Id);

                            AddRecalcRequest(service, oldRow, requests, tracing);
                            AddRecalcRequest(service, newRow, requests, tracing);
                            break;
                        }

                    case "Delete":
                        {
                            if (preImage == null)
                            {
                                tracing.Trace("Delete requires a PreImage. Nothing to process. Ensure PreImage is registered.");
                                return;
                            }

                            AddRecalcRequest(service, preImage, requests, tracing);
                            break;
                        }
                }

                var distinctRequests = requests
                    .Where(x => x.WorkOrderId != Guid.Empty && !string.IsNullOrWhiteSpace(x.ProductNumber))
                    .GroupBy(x => $"{x.WorkOrderId:D}|{x.ProductNumber}", StringComparer.OrdinalIgnoreCase)
                    .Select(g => g.First())
                    .ToList();

                if (!distinctRequests.Any())
                {
                    tracing.Trace("Exit: no recalculation requests found.");
                    return;
                }

                foreach (var request in distinctRequests)
                    RecalculateForWorkOrderAndProductNumber(service, request, tracing);

                tracing.Trace("RecalculateWorkOrderProductVolumePlugin completed successfully.");
            }
            catch (Exception ex)
            {
                tracing.Trace("RecalculateWorkOrderProductVolumePlugin error: {0}", ex);
                throw new InvalidPluginExecutionException(
                    "An error occurred in RecalculateWorkOrderProductVolumePlugin.",
                    ex);
            }
        }

        #region Core Logic

        private static void RecalculateForWorkOrderAndProductNumber(
            IOrganizationService service,
            RecalcRequest request,
            ITracingService tracing)
        {
            tracing.Trace(
                "Recalculating. WorkOrder={0}, ProductNumber={1}, ProductId={2}",
                request.WorkOrderId,
                request.ProductNumber,
                request.ProductRef?.Id);

            // Source values are already stored in cubic yards.
            decimal totalVolumeCubicYards = GetRolledUpVolumeForWorkOrderAndProductNumber(
                service,
                request.WorkOrderId,
                request.ProductNumber,
                tracing);

            tracing.Trace(
                "Rolled up volume. WorkOrder={0}, ProductNumber={1}, CubicYards={2}",
                request.WorkOrderId,
                request.ProductNumber,
                totalVolumeCubicYards);

            Entity existingWorkOrderProduct = FindExistingWorkOrderProduct(
                service,
                request.WorkOrderId,
                request.ProductRef,
                request.ProductNumber,
                tracing);

            if (existingWorkOrderProduct != null)
            {
                decimal existingQty = GetDecimalValue(existingWorkOrderProduct, WorkOrderProductQuantityField);

                if (existingQty != totalVolumeCubicYards)
                {
                    Entity update = new Entity(WorkOrderProductEntityName, existingWorkOrderProduct.Id);

                    // msdyn_quantity is a Double field in Dataverse — cast required.
                    update[WorkOrderProductQuantityField] = (double)totalVolumeCubicYards;

                    if (totalVolumeCubicYards > 0m)
                    {
                        update[WorkOrderProductLineStatusField] = new OptionSetValue(WorkOrderProductLineStatusUsed);
                    }

                    service.Update(update);

                    tracing.Trace(
                        "Updated Work Order Product. WorkOrderProductId={0}, OldQty={1}, NewQty={2} (cubic yards), LineStatusSetToUsed={3}",
                        existingWorkOrderProduct.Id,
                        existingQty,
                        totalVolumeCubicYards,
                        totalVolumeCubicYards > 0m);
                }
                else
                {
                    tracing.Trace(
                        "No update needed. WorkOrderProductId={0}, msdyn_quantity already = {1} (cubic yards)",
                        existingWorkOrderProduct.Id,
                        totalVolumeCubicYards);
                }

                return;
            }

            if (totalVolumeCubicYards <= 0m)
            {
                tracing.Trace(
                    "No Work Order Product exists and total volume is zero. Skipping create. WorkOrder={0}, ProductNumber={1}",
                    request.WorkOrderId,
                    request.ProductNumber);
                return;
            }

            EntityReference productToCreate = request.ProductRef;

            if (productToCreate == null)
            {
                tracing.Trace(
                    "ProductRef was null on request. Attempting fallback lookup by product number {0}",
                    request.ProductNumber);

                productToCreate = ResolveProductReferenceByProductNumber(service, request.ProductNumber, tracing);
            }

            if (productToCreate == null)
            {
                tracing.Trace(
                    "Unable to resolve product reference. Skipping create. WorkOrder={0}, ProductNumber={1}",
                    request.WorkOrderId,
                    request.ProductNumber);
                return;
            }

            string productName = productToCreate.Name ?? request.ProductNumber;

            Entity create = new Entity(WorkOrderProductEntityName);
            create[WorkOrderProductToWorkOrderField] = new EntityReference(WorkOrderEntityName, request.WorkOrderId);
            create[WorkOrderProductToProductField] = productToCreate;
            create[WorkOrderProductQuantityField] = (double)totalVolumeCubicYards;

            if (totalVolumeCubicYards > 0m)
            {
                create[WorkOrderProductLineStatusField] = new OptionSetValue(WorkOrderProductLineStatusUsed);
            }

            create[WorkOrderProductNameField] = $"Aggregated: {productName}";

            Guid createdId = service.Create(create);

            tracing.Trace(
                "Created Work Order Product. Id={0}, WorkOrder={1}, ProductId={2}, ProductNumber={3}, msdyn_quantity={4} (cubic yards), LineStatusSetToUsed={5}",
                createdId,
                request.WorkOrderId,
                productToCreate.Id,
                request.ProductNumber,
                totalVolumeCubicYards,
                totalVolumeCubicYards > 0m);
        }

        private static decimal GetRolledUpVolumeForWorkOrderAndProductNumber(
            IOrganizationService service,
            Guid workOrderId,
            string productNumber,
            ITracingService tracing)
        {
            List<Guid> holeDetailIds = GetHoleDetailIdsForWorkOrder(service, workOrderId, tracing);

            if (!holeDetailIds.Any())
            {
                tracing.Trace("No hole details found for WorkOrder={0}", workOrderId);
                return 0m;
            }

            decimal total = 0m;

            foreach (List<Guid> batch in Chunk(holeDetailIds, 200))
            {
                QueryExpression query = new QueryExpression(HoleCalculationEntityName)
                {
                    ColumnSet = new ColumnSet(HoleCalculationVolumeField, HoleCalculationProductField)
                };

                query.Criteria.AddCondition(
                    HoleCalculationToHoleDetailField,
                    ConditionOperator.In,
                    batch.Cast<object>().ToArray());

                query.Criteria.AddCondition(HoleCalculationProductField, ConditionOperator.NotNull);
                query.Criteria.AddCondition(HoleCalculationVolumeField, ConditionOperator.NotNull);
                query.Criteria.AddCondition(StateCodeField, ConditionOperator.Equal, ActiveStateCode);

                LinkEntity productLink = query.AddLink(
                    ProductEntityName,
                    HoleCalculationProductField,
                    "productid",
                    JoinOperator.Inner);

                productLink.EntityAlias = "prod";
                productLink.Columns = new ColumnSet(ProductNumberField);
                productLink.LinkCriteria.AddCondition(ProductNumberField, ConditionOperator.Equal, productNumber);

                List<Entity> rows = RetrieveAll(service, query);

                foreach (Entity row in rows)
                    total += GetDecimalValue(row, HoleCalculationVolumeField);
            }

            tracing.Trace(
                "GetRolledUpVolumeForWorkOrderAndProductNumber finished. WorkOrder={0}, ProductNumber={1}, TotalCubicYards={2}",
                workOrderId,
                productNumber,
                total);

            return total;
        }

        private static Entity FindExistingWorkOrderProduct(
            IOrganizationService service,
            Guid workOrderId,
            EntityReference targetProductRef,
            string productNumber,
            ITracingService tracing)
        {
            if (targetProductRef != null)
            {
                QueryExpression exactQuery = new QueryExpression(WorkOrderProductEntityName)
                {
                    ColumnSet = new ColumnSet(
                        WorkOrderProductQuantityField,
                        WorkOrderProductNameField,
                        WorkOrderProductToProductField)
                };

                exactQuery.Criteria.AddCondition(WorkOrderProductToWorkOrderField, ConditionOperator.Equal, workOrderId);
                exactQuery.Criteria.AddCondition(WorkOrderProductToProductField, ConditionOperator.Equal, targetProductRef.Id);
                exactQuery.Criteria.AddCondition(StateCodeField, ConditionOperator.Equal, ActiveStateCode);

                EntityCollection exactResults = service.RetrieveMultiple(exactQuery);

                if (exactResults.Entities.Count > 0)
                {
                    Entity match = exactResults.Entities[0];
                    tracing.Trace(
                        "Matched Work Order Product by exact product ID. WorkOrder={0}, ProductId={1}, WorkOrderProductId={2}",
                        workOrderId,
                        targetProductRef.Id,
                        match.Id);
                    return match;
                }
            }

            if (!string.IsNullOrWhiteSpace(productNumber))
            {
                QueryExpression numberQuery = new QueryExpression(WorkOrderProductEntityName)
                {
                    ColumnSet = new ColumnSet(
                        WorkOrderProductQuantityField,
                        WorkOrderProductNameField,
                        WorkOrderProductToProductField)
                };

                numberQuery.Criteria.AddCondition(WorkOrderProductToWorkOrderField, ConditionOperator.Equal, workOrderId);
                numberQuery.Criteria.AddCondition(StateCodeField, ConditionOperator.Equal, ActiveStateCode);

                LinkEntity productLink = numberQuery.AddLink(
                    ProductEntityName,
                    WorkOrderProductToProductField,
                    "productid",
                    JoinOperator.Inner);

                productLink.EntityAlias = "prod";
                productLink.Columns = new ColumnSet(ProductNumberField);
                productLink.LinkCriteria.AddCondition(ProductNumberField, ConditionOperator.Equal, productNumber);

                EntityCollection numberResults = service.RetrieveMultiple(numberQuery);

                if (numberResults.Entities.Count > 0)
                {
                    Entity match = numberResults.Entities[0];
                    tracing.Trace(
                        "Matched Work Order Product by product number. WorkOrder={0}, ProductNumber={1}, WorkOrderProductId={2}",
                        workOrderId,
                        productNumber,
                        match.Id);
                    return match;
                }
            }

            tracing.Trace(
                "No matching Work Order Product found. WorkOrder={0}, ProductNumber={1}, ProductId={2}",
                workOrderId,
                productNumber,
                targetProductRef?.Id);

            return null;
        }

