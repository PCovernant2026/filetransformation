using Microsoft.Xrm.Sdk;
using Microsoft.Xrm.Sdk.Query;
using System;
using System.Linq;
using System.ServiceModel;
using System.Text.RegularExpressions;

namespace Winco.Dynamics365.Plugins
{
    public class SharepointOpportunityAttachmentSync : IPlugin
    {
        public void Execute(IServiceProvider serviceProvider)
        {
            var tracingService =
                (ITracingService)serviceProvider.GetService(typeof(ITracingService));

            var context =
                (IPluginExecutionContext)serviceProvider.GetService(typeof(IPluginExecutionContext));

            if (context == null)
            {
                throw new InvalidPluginExecutionException("Plugin execution context is null.");
            }

            var serviceFactory =
                (IOrganizationServiceFactory)serviceProvider.GetService(typeof(IOrganizationServiceFactory));

            var service = serviceFactory.CreateOrganizationService(context.UserId);

            Trace(tracingService, "============================================================");
            Trace(tracingService, "ENTER SharepointOpportunityAttachmentSync");
            TraceContext(tracingService, context, "START");

            try
            {
                bool isCreate = string.Equals(
                    context.MessageName,
                    "Create",
                    StringComparison.OrdinalIgnoreCase);

                bool isUpdate = string.Equals(
                    context.MessageName,
                    "Update",
                    StringComparison.OrdinalIgnoreCase);

                Trace(
                    tracingService,
                    "Trigger validation. Message={0}, IsCreate={1}, IsUpdate={2}",
                    context.MessageName,
                    isCreate,
                    isUpdate);

                if (!isCreate && !isUpdate)
                {
                    Trace(
                        tracingService,
                        "EXIT: Unsupported message '{0}'. Only Create and Update are supported.",
                        context.MessageName);
                    return;
                }

                if (!string.Equals(
                    context.PrimaryEntityName,
                    AnnotationEntity.LogicalName,
                    StringComparison.OrdinalIgnoreCase))
                {
                    Trace(
                        tracingService,
                        "EXIT: Primary entity '{0}' is not '{1}'.",
                        context.PrimaryEntityName,
                        AnnotationEntity.LogicalName);
                    return;
                }

                Trace(
                    tracingService,
                    "InputParameters count: {0}",
                    context.InputParameters?.Count ?? 0);

                TraceParameterNames(tracingService, context);

                if (!context.InputParameters.Contains("Target"))
                {
                    Trace(tracingService, "EXIT: InputParameters does not contain Target.");
                    return;
                }

                Entity target = context.InputParameters["Target"] as Entity;

                if (target == null)
                {
                    Trace(
                        tracingService,
                        "EXIT: Target exists but is not an Entity. Actual type: {0}",
                        context.InputParameters["Target"]?.GetType().FullName ?? "(null)");
                    return;
                }

                Trace(
                    tracingService,
                    "Target received. LogicalName={0}, Id={1}, AttributeCount={2}",
                    target.LogicalName,
                    target.Id,
                    target.Attributes.Count);

                TraceEntityAttributes(tracingService, target, "TARGET");

                if (!string.Equals(
                    target.LogicalName,
                    AnnotationEntity.LogicalName,
                    StringComparison.OrdinalIgnoreCase))
                {
                    Trace(
                        tracingService,
                        "EXIT: Target logical name '{0}' is not '{1}'.",
                        target.LogicalName,
                        AnnotationEntity.LogicalName);
                    return;
                }

                Guid annotationId = target.Id != Guid.Empty
                    ? target.Id
                    : context.PrimaryEntityId;

                Trace(
                    tracingService,
                    "Resolved Annotation ID. Target.Id={0}, PrimaryEntityId={1}, Resolved={2}",
                    target.Id,
                    context.PrimaryEntityId,
                    annotationId);

                if (annotationId == Guid.Empty)
                {
                    Trace(tracingService, "EXIT: Annotation ID could not be resolved.");
                    return;
                }

                if (isUpdate)
                {
                    Trace(
                        tracingService,
                        "Update trigger attributes: {0}",
                        target.Attributes.Count == 0
                            ? "(none)"
                            : string.Join(", ", target.Attributes.Keys.OrderBy(k => k)));

                    bool relevantFieldChanged =
                        target.Attributes.Contains(AnnotationFields.IsDocument) ||
                        target.Attributes.Contains(AnnotationFields.FileName) ||
                        target.Attributes.Contains(AnnotationFields.DocumentBody) ||
                        target.Attributes.Contains(AnnotationFields.ObjectId);

                    Trace(
                        tracingService,
                        "Relevant attachment field changed: {0}",
                        relevantFieldChanged);

                    if (!relevantFieldChanged)
                    {
                        Trace(
                            tracingService,
                            "EXIT: Update did not contain isdocument, filename, documentbody, or objectid.");
                        return;
                    }
                }

                Trace(
                    tracingService,
                    "Retrieving full annotation row {0}.",
                    annotationId);

                Entity note = service.Retrieve(
                    AnnotationEntity.LogicalName,
                    annotationId,
                    new ColumnSet(
                        AnnotationFields.IsDocument,
                        AnnotationFields.FileName,
                        AnnotationFields.DocumentBody,
                        AnnotationFields.ObjectId));

                Trace(
                    tracingService,
                    "Annotation retrieve succeeded. Id={0}, AttributeCount={1}",
                    note.Id,
                    note.Attributes.Count);

                TraceEntityAttributes(tracingService, note, "ANNOTATION");

                bool isDocument =
                    note.GetAttributeValue<bool?>(AnnotationFields.IsDocument) ?? false;

                string fileName =
                    note.GetAttributeValue<string>(AnnotationFields.FileName);

                string documentBody =
                    note.GetAttributeValue<string>(AnnotationFields.DocumentBody);

                EntityReference regarding =
                    note.GetAttributeValue<EntityReference>(AnnotationFields.ObjectId);

                Trace(tracingService, "Annotation evaluation:");
                Trace(tracingService, " - IsDocument={0}", isDocument);
                Trace(
                    tracingService,
                    " - FileName={0}",
                    string.IsNullOrWhiteSpace(fileName) ? "(null/empty)" : fileName);
                Trace(
                    tracingService,
                    " - DocumentBodyPresent={0}",
                    !string.IsNullOrWhiteSpace(documentBody));
                Trace(
                    tracingService,
                    " - DocumentBodyLength={0}",
                    documentBody?.Length ?? 0);
                Trace(
                    tracingService,
                    " - RegardingPresent={0}",
                    regarding != null);
                Trace(
                    tracingService,
                    " - RegardingLogicalName={0}",
                    regarding?.LogicalName ?? "(null)");
                Trace(
                    tracingService,
                    " - RegardingId={0}",
                    regarding?.Id.ToString() ?? "(null)");

                if (!isDocument)
                {
                    Trace(
                        tracingService,
                        "SKIP: Annotation isdocument is false. Message={0}, AnnotationId={1}",
                        context.MessageName,
                        annotationId);
                    return;
                }

                if (string.IsNullOrWhiteSpace(fileName))
                {
                    Trace(
                        tracingService,
                        "SKIP: Annotation filename is empty. Message={0}, AnnotationId={1}",
                        context.MessageName,
                        annotationId);
                    return;
                }

                if (string.IsNullOrWhiteSpace(documentBody))
                {
                    Trace(
                        tracingService,
                        "SKIP: Annotation documentbody is empty. " +
                        "For workflow-created files, confirm an Update step is registered " +
                        "with filtering attributes documentbody,filename,isdocument,objectid. " +
                        "Message={0}, AnnotationId={1}",
                        context.MessageName,
                        annotationId);
                    return;
                }

                if (regarding == null)
                {
                    Trace(
                        tracingService,
                        "SKIP: Annotation objectid is null. Message={0}, AnnotationId={1}",
                        context.MessageName,
                        annotationId);
                    return;
                }

                if (!string.Equals(
                    regarding.LogicalName,
                    OpportunityEntity.LogicalName,
                    StringComparison.OrdinalIgnoreCase))
                {
                    Trace(
                        tracingService,
                        "SKIP: Annotation is regarding '{0}' ({1}), not opportunity.",
                        regarding.LogicalName,
                        regarding.Id);
                    return;
                }

                string annotationIdText = note.Id.ToString("D");

                Trace(
                    tracingService,
                    "Starting duplicate check. Table={0}, Field={1}, Value={2}",
                    TrackingEntity.LogicalName,
                    TrackingFields.AnnotationId,
                    annotationIdText);

                QueryExpression existingQuery =
                    new QueryExpression(TrackingEntity.LogicalName)
                    {
                        ColumnSet = new ColumnSet(
                            TrackingFields.Name,
                            TrackingFields.AnnotationId,
                            TrackingFields.SyncStatus),
                        TopCount = 1
                    };

                existingQuery.Criteria.AddCondition(
                    TrackingFields.AnnotationId,
                    ConditionOperator.Equal,
                    annotationIdText);

                EntityCollection existingRows =
                    service.RetrieveMultiple(existingQuery);

                Trace(
                    tracingService,
                    "Duplicate check completed. ResultCount={0}",
                    existingRows.Entities.Count);

                if (existingRows.Entities.Count > 0)
                {
                    Entity existingRow = existingRows.Entities[0];
                    OptionSetValue existingStatus =
                        existingRow.GetAttributeValue<OptionSetValue>(TrackingFields.SyncStatus);

                    Trace(
                        tracingService,
                        "EXIT: Tracking row already exists. " +
                        "TrackingId={0}, Name={1}, AnnotationId={2}, Status={3}",
                        existingRow.Id,
                        existingRow.GetAttributeValue<string>(TrackingFields.Name) ?? "(null)",
                        existingRow.GetAttributeValue<string>(TrackingFields.AnnotationId) ?? "(null)",
                        existingStatus?.Value.ToString() ?? "(null)");
                    return;
                }

                Trace(
                    tracingService,
                    "Retrieving Opportunity. OpportunityId={0}",
                    regarding.Id);

                Entity opportunity = service.Retrieve(
                    OpportunityEntity.LogicalName,
                    regarding.Id,
                    new ColumnSet(OpportunityFields.Name));

                Trace(
                    tracingService,
                    "Opportunity retrieve succeeded. Id={0}, AttributeCount={1}",
                    opportunity.Id,
                    opportunity.Attributes.Count);

                TraceEntityAttributes(tracingService, opportunity, "OPPORTUNITY");

                string opportunityName =
                    opportunity.GetAttributeValue<string>(OpportunityFields.Name);

                Trace(
                    tracingService,
                    "Opportunity Name={0}",
                    string.IsNullOrWhiteSpace(opportunityName)
                        ? "(null/empty)"
                        : opportunityName);

                string sanitizedOpportunityName =
                    SharePointNameHelper.SanitizeForSharePoint(opportunityName);

                string folderName =
                    SharePointNameHelper.BuildOpportunityFolderName(
                        opportunityName,
                        regarding.Id);

                Trace(tracingService, "SharePoint folder-name generation:");
                Trace(
                    tracingService,
                    " - OriginalOpportunityName={0}",
                    opportunityName ?? "(null)");
                Trace(
                    tracingService,
                    " - SanitizedOpportunityName={0}",
                    sanitizedOpportunityName);
                Trace(
                    tracingService,
                    " - FinalFolderName={0}",
                    folderName);
                Trace(
                    tracingService,
                    " - FinalFolderNameLength={0}",
                    folderName?.Length ?? 0);

                string trackingName =
                    BuildTrackingName(fileName, opportunityName, note.Id);

                Trace(
                    tracingService,
                    "Tracking name generated. Value={0}, Length={1}",
                    trackingName,
                    trackingName?.Length ?? 0);

                Entity trackingRow = new Entity(TrackingEntity.LogicalName);
                trackingRow[TrackingFields.Name] = trackingName;
                trackingRow[TrackingFields.OpportunityId] =
                    new EntityReference(OpportunityEntity.LogicalName, regarding.Id);
                trackingRow[TrackingFields.AnnotationId] = annotationIdText;
                trackingRow[TrackingFields.DocName] = fileName;
                trackingRow[TrackingFields.SyncStatus] =
                    new OptionSetValue(TrackingStatusValues.Pending);
                trackingRow[TrackingFields.TargetFolderName] = folderName;
                trackingRow[TrackingFields.SharePointError] = null;
                trackingRow[TrackingFields.SharePointFileUrl] = null;

                TraceEntityAttributes(tracingService, trackingRow, "TRACKING ROW BEFORE CREATE");

                Trace(
                    tracingService,
                    "Creating tracking row. Table={0}",
                    TrackingEntity.LogicalName);

                Guid trackingId = service.Create(trackingRow);

                Trace(
                    tracingService,
                    "SUCCESS: Tracking row created. TrackingId={0}, AnnotationId={1}, OpportunityId={2}",
                    trackingId,
                    annotationIdText,
                    regarding.Id);

                TraceContext(tracingService, context, "END");
                Trace(tracingService, "EXIT SharepointOpportunityAttachmentSync - SUCCESS");
                Trace(tracingService, "============================================================");
            }
            catch (FaultException<OrganizationServiceFault> ex)
            {
                Trace(tracingService, "ORGANIZATION SERVICE FAULT");
                Trace(tracingService, "Message={0}", ex.Message);
                Trace(tracingService, "DetailMessage={0}", ex.Detail?.Message ?? "(no detail)");
                Trace(tracingService, "ErrorCode={0}", ex.Detail?.ErrorCode.ToString() ?? "(null)");
                Trace(tracingService, "Timestamp={0}", ex.Detail?.Timestamp.ToString("O") ?? "(null)");
                Trace(tracingService, "ActivityId={0}", ex.Detail?.ActivityId.ToString() ?? "(null)");
                Trace(tracingService, "TraceText={0}", ex.Detail?.TraceText ?? "(null)");
                Trace(tracingService, "FullException={0}", ex);
                throw;
            }
            catch (InvalidPluginExecutionException ex)
            {
                Trace(tracingService, "INVALID PLUGIN EXECUTION EXCEPTION");
                Trace(tracingService, "Message={0}", ex.Message);
                Trace(tracingService, "FullException={0}", ex);
                throw;
            }
            catch (Exception ex)
            {
                Trace(tracingService, "UNHANDLED EXCEPTION");
                Trace(tracingService, "ExceptionType={0}", ex.GetType().FullName);
                Trace(tracingService, "Message={0}", ex.Message);
                Trace(tracingService, "StackTrace={0}", ex.StackTrace ?? "(no stack trace)");
                Trace(tracingService, "InnerException={0}", ex.InnerException?.ToString() ?? "(none)");
                Trace(tracingService, "FullException={0}", ex);

                throw new InvalidPluginExecutionException(
                    "An error occurred in SharepointOpportunityAttachmentSync. " +
                    "Review the Plugin Trace Log using the correlation ID from this execution.",
                    ex);
            }
        }

        private static void Trace(
            ITracingService tracingService,
            string message,
            params object[] args)
        {
            if (tracingService == null)
            {
                return;
            }

            if (args == null || args.Length == 0)
            {
                tracingService.Trace(message);
                return;
            }

            tracingService.Trace(message, args);
        }

