    internal static class SharePointNameHelper
    {
        public static string BuildOpportunityFolderName(string opportunityName, Guid opportunityId)
        {
            string cleanName = SanitizeForSharePoint(opportunityName);
            return $"{cleanName}_{opportunityId:D}";
        }

        public static string SanitizeForSharePoint(string input)
        {
            if (string.IsNullOrWhiteSpace(input))
            {
                return "Opportunity";
            }

            string cleaned = Regex.Replace(input, @"[/\\:\*\?""<>\|#%]", string.Empty);
            cleaned = new string(cleaned.Where(c => !char.IsControl(c)).ToArray());
            cleaned = Regex.Replace(cleaned, @"\s+", " ").Trim();
            cleaned = cleaned.Trim().TrimEnd('.');

            const int maxLength = 120;
            if (cleaned.Length > maxLength)
            {
                cleaned = cleaned.Substring(0, maxLength).Trim().TrimEnd('.');
            }

            if (string.IsNullOrWhiteSpace(cleaned))
            {
                return "Opportunity";
            }

            return cleaned;
        }
    }
