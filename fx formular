function hide(fieldName, isCheckBox) {
    if ($("#" + fieldName) != null) {
        if (isCheckBox === true && formIsOnLoad == false)
            document.getElementById(fieldName).checked = false;
        else if (formIsOnLoad == false)
            $("#" + fieldName).val(null);

        $("#" + fieldName + "_label").hide();
        $("#" + fieldName).hide();
    }
}

function rfqTypeChange() {
    if (processWhenRFQTypeSet) {
        setDateProcessingNotification();
    }
}

function setDateProcessingNotification() {
    var message = "{0} RFQ's required {1} business days to process.";

    if ($("#new_quoteneededby") != null && $("#new_typeofrfq") != null) {
        var bidDateValue = $("#new_quoteneededby").val();
        var rfqType = $("#new_typeofrfq").val();
        currentValueQuoteNeededBy;
        CurrentValueRfqType
        if (bidDateValue != currentValueQuoteNeededBy || rfqType != CurrentValueRfqType) {
            if (bidDateValue != currentValueQuoteNeededBy)
                processWhenRFQTypeSet = true;
            currentValueQuoteNeededBy = bidDateValue;
            CurrentValueRfqType = rfqType;

            if (rfqType != null && rfqType != "") {
                if (bidDateValue != null && bidDateValue != "") {
                    var dateFormat = "YYYY-MM-DDTHH:mm:ss.SSSSSSS";
                    var message = "{0} RFQ's required {1} business days to process.";
                    var bidDate = new Date(bidDateValue);
                    var shouldPost = false;
                    var businessDays = getBusinessDatesCount(new Date(), bidDate);

                    if (rfqType == 100000000 && businessDays < 5) {//Standard
                        message = message.replace("{0}", "Standard").replace("{1}", "5");
                        shouldPost = true;

                        var futureDate = new Date();
                        addBusinessDays(futureDate, 5);
                        $("#new_quoteneededby").val(moment.utc(futureDate).format(dateFormat));

                        var $display = $("#new_quoteneededby").nextAll(".datetimepicker").children("input");
                        $display.val(futureDate.format("MM/dd/yyyy"));
                    } else if (rfqType == 100000001 && businessDays < 9) {//Engineering/Blast
                        message = message.replace("{0}", "Engineering/Blast").replace("{1}", "9");
                        shouldPost = true;

                        var futureDate = new Date();
                        addBusinessDays(futureDate, 9);
                        $("#new_quoteneededby").val(moment.utc(futureDate).format(dateFormat));

                        var $display = $("#new_quoteneededby").nextAll(".datetimepicker").children("input");
                        $display.val(futureDate.format("MM/dd/yyyy"));
                    } else if (rfqType == 100000002 && businessDays < 11) {//Plans/Spec
                        message = message.replace("{0}", "Plans/Spec").replace("{1}", "11");
                        shouldPost = true;

                        var futureDate = new Date();
                        addBusinessDays(futureDate, 11);
                        $("#new_quoteneededby").val(moment.utc(futureDate).format(dateFormat));

                        var $display = $("#new_quoteneededby").nextAll(".datetimepicker").children("input");
                        $display.val(futureDate.format("MM/dd/yyyy"));
                    } else {
                        var updateDate = false;
                        switch (bidDate.getDay()) {
                            case 6:
                                bidDate.setDate(bidDate.getDate() + 2);
                                updateDate = true;
                                break;
                            case 0:
                                bidDate.setDate(bidDate.getDate() + 1);
                                updateDate = true;
                                break;
                        }

                        if (updateDate) {
                            message = "Quotes can only be supplied on M-F, please review when you need the estimate.";
                            shouldPost = true;

                            $("#new_quoteneededby").val(moment.utc(bidDate).format(dateFormat));

                            var $display = $("#new_quoteneededby").nextAll(".datetimepicker").children("input");
                            $display.val(bidDate.format("Mm/dd/yyyy"));
                        }
                    }

                    if (shouldPost)
                        setTimeout(function () { alert(message); }, 200);
                }
            } else {
                processWhenRFQTypeSet = true;
            }
        }
    } else if ($("#new_quoteneededby") == null || $("#new_quoteneededby") != undefined || $("#new_quoteneededby") != "") {
        if (rfqType == 100000000) {//Standard
            message = message.replace("{0}", "Standard").replace("{1}", "5");
            shouldPost = true;

            var futureDate = new Date();
            addBusinessDays(futureDate, 5);
            $("#new_quoteneededby").val(moment.utc(futureDate).format(dateFormat));

            var $display = $("#new_quoteneededby").nextAll(".datetimepicker").children("input");
            $display.val(futureDate.format("MM/dd/yyyy"));
        } else if (rfqType == 100000001) {//Engineering/Blast
            message = message.replace("{0}", "Engineering/Blast").replace("{1}", "9");
            shouldPost = true;

            var futureDate = new Date();
            addBusinessDays(futureDate, 9);
            $("#new_quoteneededby").val(moment.utc(futureDate).format(dateFormat));

            var $display = $("#new_quoteneededby").nextAll(".datetimepicker").children("input");
            $display.val(futureDate.format("MM/dd/yyyy"));
        } else if (rfqType == 100000002) {//Plans/Spec
            message = message.replace("{0}", "Plans/Spec").replace("{1}", "11");
            shouldPost = true;

            var futureDate = new Date();
            addBusinessDays(futureDate, 11);
            $("#new_quoteneededby").val(moment.utc(futureDate).format(dateFormat));

            var $display = $("#new_quoteneededby").nextAll(".datetimepicker").children("input");
            $display.val(futureDate.format("MM/dd/yyyy"));
        }
    }
}

function getBusinessDatesCount(startDate, endDate) {
    var count = 0;
    var curDate = startDate;
    while (curDate <= endDate) {
        var dayOfWeek = curDate.getDay();
        if (!((dayOfWeek == 6) || (dayOfWeek == 0)))
            count++;
        curDate.setDate(curDate.getDate() + 1);
    }

    return count;
}

function addBusinessDays(startDate, numBusinessDays) {
    var curDate = startDate;
    while (numBusinessDays > 0) {
        var dayOfWeek = curDate.getDay();
        if (!((dayOfWeek == 6) || (dayOfWeek == 0)))
            numBusinessDays--;
        curDate.setDate(curDate.getDate() + 1);
    }

    //Skips the weekend.
    if (curDate.getDay() == 6)
        curDate.setDate(curDate.getDate() + 2);
    else if (curDate.getDay() == 0)
        curDate.setDate(curDate.getDate() + 1);
}

