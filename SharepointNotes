
SELECT
    a.annotationid,
    a.objectid,
    a.filename,
    a.mimetype,
    a.createdon,
    a.modifiedon,
    a.createdbyname,
    a.modifiedbyname
FROM annotation AS a
LEFT JOIN ctp_notesharepointsync AS note_sync
    ON CONVERT(NVARCHAR(36), a.annotationid) = note_sync.ctp_annotationid
WHERE a.isdocument = 1
  AND a.objecttypecode = 3
  AND a.mimetype =
      'application/vnd.openxmlformats-officedocument.wordprocessingml.document'
  AND a.filename LIKE 'PRINT RFQ%'
  AND note_sync.ctp_annotationid IS NULL
ORDER BY a.createdon DESC;


