"use strict";

function vgsd_getAgingIcon(rowData, userLCID) {      
    var str = JSON.parse(rowData);  
    var coldata = str.vgsd_agingstatus_Value || str.vgsd_agingstatus;  
    var imgName = "";  
    var tooltip = "";  

    switch (parseInt(coldata, 10)) { 
        case 328980000:  
            imgName = "vgsd_greenicon";  
            tooltip = "Normal: less than 21 days old";  
            break;  

        case 328980001:  
            imgName = "vgsd_yellowIcon";  
            tooltip = "Warning: 21 to 29 days old";  
            break;  

        case 328980002:  
            imgName = "vgsd_RedIcon";  
            tooltip = "Critical: 30 or more days old";  
            break;  

        default:  
            imgName = "";  
            tooltip = "";  
            break;  
    }  

    var resultarray = [imgName, tooltip];  
    return resultarray;  
}


